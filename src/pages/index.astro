---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroCarousel from "../components/HeroCarousel.astro";

const heroSlides = [
  {
    image: "https://images.unsplash.com/photo-1513828583688-c52646db42da?w=1920&q=80&fit=crop",
    tag: "Filosofía de diseño",
    title: "Raíz japonesa.\nIngeniería sin compromiso.",
    desc: "理路: razonamiento coherente. Cada algoritmo de Riro hereda esa disciplina — estructurado, trazable, sin atajos.",
    cta: { label: "Hablemos de tu proyecto", href: "/contacto" },
  },
  {
    image: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1920&q=80&fit=crop",
    tag: "Edge computing industrial",
    title: "Edge computing para la industria\nque no puede esperar.",
    desc: "Cómputo en el borde del perímetro industrial: decisiones locales, sin dependencia de conectividad externa o nube.",
    cta: { label: "Ver soluciones OPS", href: "/ops" },
  },
  {
    image: "https://images.unsplash.com/photo-1635070041078-e363dbe005cb?w=1920&q=80&fit=crop",
    tag: "Inteligencia artificial",
    title: "Inteligencia artificial instalada.\nNo rentada.",
    desc: "El modelo corre en tu infraestructura. Sin costo por inferencia, sin datos que salgan del perímetro, sin lock-in.",
    cta: { label: "Conocer Riro OPS", href: "/ops" },
  },
  {
    image: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920&q=80&fit=crop",
    tag: "Trazabilidad total",
    title: "Transparencia total.\nSin letra chica.",
    desc: "Cada alerta tiene origen, lógica y contexto documentados. Nada ocurre dentro de Riro que no sea auditable.",
    cta: { label: "Ver el proceso", href: "/#proceso" },
  },
  {
    image: "https://images.unsplash.com/photo-1573164713714-d95e436ab8d6?w=1920&q=80&fit=crop",
    tag: "Procesamiento local",
    title: "Inferencia local.\nSin latencia. Sin dependencias.",
    desc: "El hardware razona en sitio. Sin intermediario en la nube, sin latencia añadida, sin punto único de fallo externo.",
    cta: { label: "Solicitar evaluación", href: "/contacto" },
  },
];
---

<BaseLayout title="Riro Systems | Automatización con criterio">
  <main class="overflow-x-hidden">

    <!-- ══════════════════════════ HERO CAROUSEL ══════════════════════════ -->
    <div id="inicio">
      <HeroCarousel slides={heroSlides} />
    </div>


    <!-- ══════════════════════ EL CRITERIO ══════════════════════ -->
    <section id="criterio" class="py-32 px-6 bg-white">
      <div class="max-w-6xl mx-auto">

        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-[#4A7FA5]"></span>
          <span class="text-[#4A7FA5] text-xs font-medium tracking-[0.22em] uppercase">Filosofía de trabajo</span>
        </div>

        <h2 class="text-4xl md:text-5xl font-bold text-[#1B2A4A] mb-16 leading-tight">
          El Criterio
        </h2>

        <!-- Grid dos columnas -->
        <div class="criterio-wrapper">

          <!-- Qué no hacemos -->
          <div class="criterio-col">
            <div class="flex items-center gap-3 mb-8">
              <span class="criterio-num">01</span>
              <span class="w-10 h-px bg-[#1B2A4A]/10"></span>
            </div>
            <h3 class="text-xl font-medium text-[#1B2A4A]/40 mb-8">Qué no hacemos</h3>
            <ul class="space-y-5">
              <li class="criterio-item criterio-item--no">
                <span class="criterio-mark criterio-mark--no">✕</span>
                <span>No somos SaaS</span>
              </li>
              <li class="criterio-item criterio-item--no">
                <span class="criterio-mark criterio-mark--no">✕</span>
                <span>No vendemos gadgets sueltos</span>
              </li>
              <li class="criterio-item criterio-item--no">
                <span class="criterio-mark criterio-mark--no">✕</span>
                <span>No enviamos tus datos a la nube sin criterio</span>
              </li>
            </ul>
          </div>

          <!-- Qué hacemos -->
          <div class="criterio-col criterio-col--right">
            <div class="flex items-center gap-3 mb-8">
              <span class="criterio-num criterio-num--si">02</span>
              <span class="w-10 h-px bg-[#1B2A4A]/10"></span>
            </div>
            <h3 class="text-xl font-medium text-[#2B96AD] mb-8">Qué hacemos</h3>
            <ul class="space-y-5">
              <li class="criterio-item criterio-item--si">
                <span class="criterio-mark criterio-mark--si">→</span>
                <span>Diseñamos ecosistemas con criterio</span>
              </li>
              <li class="criterio-item criterio-item--si">
                <span class="criterio-mark criterio-mark--si">→</span>
                <span>Hardware en propiedad del cliente</span>
              </li>
              <li class="criterio-item criterio-item--si">
                <span class="criterio-mark criterio-mark--si">→</span>
                <span>Procesamiento 100% local</span>
              </li>
            </ul>
          </div>

        </div>
      </div>
    </section>


    <!-- ═════════════════════ NUESTRAS LÍNEAS ═════════════════════ -->
    <section id="lineas" class="py-32 px-6 bg-[#F4F7FA]">
      <div class="max-w-6xl mx-auto">

        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-[#2B96AD]"></span>
          <span class="text-[#2B96AD] text-xs font-medium tracking-[0.22em] uppercase">Productos</span>
        </div>

        <h2 class="text-4xl md:text-5xl font-bold text-[#1B2A4A] mb-16 leading-tight">
          Nuestras Líneas
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <!-- RIRO HOME -->
          <div class="linea-card linea-card--home">
            <span class="linea-accent linea-accent--home"></span>
            <div class="linea-body">
              <span class="linea-badge linea-badge--home">HOME</span>
              <h3 class="linea-title">RIRO<br />HOME</h3>
              <p class="linea-desc">
                Ecosistema residencial inteligente. Tu hogar automatizado con hardware que posees
                y privacidad que controlás.
              </p>
              <a href="/home" class="linea-link linea-link--home">
                Conocer solución <span>→</span>
              </a>
            </div>
          </div>

          <!-- RIRO OPS -->
          <div class="linea-card linea-card--ops">
            <span class="linea-accent linea-accent--ops"></span>
            <div class="linea-body">
              <span class="linea-badge linea-badge--ops">OPS</span>
              <h3 class="linea-title">RIRO<br />OPS</h3>
              <p class="linea-desc">
                Inteligencia operativa y monitoreo industrial. Visibilidad real de tu operación
                sin cámaras invasivas ni datos en la nube.
              </p>
              <a href="/ops" class="linea-link linea-link--ops">
                Conocer solución <span>→</span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>


    <!-- ══════════════════════ EL PROCESO ══════════════════════ -->
    <section id="proceso" class="py-32 px-6 bg-white">
      <div class="max-w-6xl mx-auto">

        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-[#4A7FA5]"></span>
          <span class="text-[#4A7FA5] text-xs font-medium tracking-[0.22em] uppercase">Metodología</span>
        </div>

        <h2 class="text-4xl md:text-5xl font-bold text-[#1B2A4A] mb-16 leading-tight">
          El Proceso
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">

          <div class="proceso-step">
            <div class="proceso-num">01</div>
            <h4 class="proceso-title">Relevamiento</h4>
            <p class="proceso-desc">
              Entendemos tu espacio, flujos y necesidades reales antes de proponer tecnología.
            </p>
          </div>

          <div class="proceso-step">
            <div class="proceso-num">02</div>
            <h4 class="proceso-title">Diseño con criterio</h4>
            <p class="proceso-desc">
              Arquitecturamos la solución mínima necesaria. Sin sobrediseño ni venta de lo que no necesitás.
            </p>
          </div>

          <div class="proceso-step">
            <div class="proceso-num">03</div>
            <h4 class="proceso-title">Instalación</h4>
            <p class="proceso-desc">
              Implementamos en tu entorno. Hardware en tu poder, código que podés auditar.
            </p>
          </div>

          <div class="proceso-step proceso-step--care">
            <div class="proceso-num proceso-num--care">04</div>
            <h4 class="proceso-title">Riro Care</h4>
            <p class="proceso-desc">
              Soporte continuo, monitoreo proactivo y mejoras iterativas. Tu sistema evoluciona con vos.
            </p>
          </div>

        </div>
      </div>
    </section>



    <!-- ══════════════════════ RIRO CARE ══════════════════════ -->
    <section id="care" class="py-32 px-6 bg-[#F4F7FA]">
      <div class="max-w-6xl mx-auto">

        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-[#2B96AD]"></span>
          <span class="text-[#2B96AD] text-xs font-medium tracking-[0.22em] uppercase">Soporte continuo</span>
        </div>

        <div class="care-header">
          <div>
            <h2 class="text-4xl md:text-5xl font-bold text-[#1B2A4A] mb-6 leading-tight">
              Riro Care.
            </h2>
            <p class="text-[#1B2A4A]/55 text-lg max-w-xl leading-relaxed">
              Tu sistema no termina en la instalación. Riro Care es el soporte continuo
              que mantiene tu ecosistema funcionando, evolucionando y en tus manos.
            </p>
          </div>
          <div class="care-badge-wrap">
            <span class="care-badge">04</span>
          </div>
        </div>

        <div class="care-grid">

          <div class="care-card">
            <div class="care-icon">◈</div>
            <h3 class="care-title">Monitoreo proactivo</h3>
            <p class="care-desc">
              Detectamos anomalías antes de que afecten tu operación.
              No esperamos el reporte — actuamos antes.
            </p>
          </div>

          <div class="care-card">
            <div class="care-icon">◈</div>
            <h3 class="care-title">Actualizaciones de modelos</h3>
            <p class="care-desc">
              Los modelos de IA y las automatizaciones se actualizan
              con los cambios de tu entorno. Sin costo de re-implementación.
            </p>
          </div>

          <div class="care-card care-card--highlight">
            <div class="care-icon care-icon--cyan">◈</div>
            <h3 class="care-title">Respuesta garantizada</h3>
            <p class="care-desc">
              SLA definido en contrato. Tiempo de respuesta real
              — no un chatbot que promete y no aparece.
            </p>
          </div>

          <div class="care-card">
            <div class="care-icon">◈</div>
            <h3 class="care-title">Evolución iterativa</h3>
            <p class="care-desc">
              Tu espacio cambia. Tu ecosistema también.
              Care incluye mejoras y ajustes a medida que crecés.
            </p>
          </div>

        </div>

        <div class="care-cta">
          <a href="/contacto" class="btn-care">
            Consultar plan Care
            <span class="care-arrow">→</span>
          </a>
          <p class="care-note">Disponible para clientes HOME y OPS</p>
        </div>

      </div>
    </section>


    <!-- ═════════════════════ CASO PILOTO ═════════════════════ -->
    <section id="caso-piloto" class="py-32 px-6 bg-white">
      <div class="max-w-6xl mx-auto">

        <div class="caso-banner">

          <!-- Decoración fondo -->
          <div class="caso-grid-bg" aria-hidden="true"></div>
          <div class="caso-circles" aria-hidden="true"></div>

          <!-- Contenido -->
          <div class="caso-content">
            <div class="flex items-center gap-3 mb-8">
              <span class="w-8 h-px bg-[#2B96AD]"></span>
              <span class="text-[#2B96AD] text-xs font-medium tracking-[0.22em] uppercase">
                Caso de Uso Real
              </span>
            </div>

            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[#1B2A4A] leading-tight mb-6 max-w-2xl">
              Inteligencia Operativa<br />
              sin invadir la privacidad.
            </h2>

            <p class="text-[#1B2A4A]/55 text-lg max-w-xl leading-relaxed mb-10">
              Descubrí cómo implementamos Inteligencia Operativa sin invadir la privacidad
              en el entorno industrial.
            </p>

            <a href="/proyecto-piloto" class="btn-primary">
              Ver Proyecto Piloto
              <span class="btn-arrow">→</span>
            </a>
          </div>

        </div>
      </div>
    </section>


  </main>
</BaseLayout>

<style>
  /* ── Tokens ──────────────────────────────────────────────── */
  :root {
    --c-navy:    #1B2A4A;
    --c-charcoal:#F4F7FA;
    --c-cyan:    #2B96AD;
    --c-steel:   #4A7FA5;
  }

  /* ══════════════════════ EL CRITERIO ══════════════════════ */
  .criterio-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid rgba(27, 42, 74, 0.08);
    border-radius: 12px;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .criterio-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .criterio-col {
    padding: 3rem;
  }

  .criterio-col--right {
    border-left: 1px solid rgba(27, 42, 74, 0.08);
  }

  @media (max-width: 768px) {
    .criterio-col--right {
      border-left: none;
      border-top: 1px solid rgba(27, 42, 74, 0.08);
    }
  }

  .criterio-num {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: rgba(27, 42, 74, 0.2);
  }

  .criterio-num--si {
    color: rgba(43, 150, 173, 0.6);
  }

  .criterio-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.55;
  }

  .criterio-item--no  { color: rgba(27, 42, 74, 0.4); }
  .criterio-item--si  { color: rgba(27, 42, 74, 0.85); }

  .criterio-mark {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 600;
    margin-top: 3px;
  }

  .criterio-mark--no { color: rgba(27, 42, 74, 0.18); }
  .criterio-mark--si { color: var(--c-cyan); }

  /* ═════════════════════ NUESTRAS LÍNEAS ═════════════════════ */
  .linea-card {
    position: relative;
    background: #FFFFFF;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(27, 42, 74, 0.08);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .linea-card:hover {
    transform: translateY(-5px);
  }

  .linea-card--home:hover { border-color: rgba(74, 127, 165, 0.35); }
  .linea-card--ops:hover  { border-color: rgba(43, 150, 173, 0.35); }

  .linea-accent {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
  }

  .linea-accent--home {
    background: linear-gradient(90deg, var(--c-steel) 0%, transparent 70%);
  }

  .linea-accent--ops {
    background: linear-gradient(90deg, var(--c-cyan) 0%, transparent 70%);
  }

  .linea-body {
    padding: 2.75rem;
    display: flex;
    flex-direction: column;
    min-height: 360px;
  }

  .linea-badge {
    display: inline-flex;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    padding: 3px 9px;
    border-radius: 4px;
    margin-bottom: 2rem;
    width: fit-content;
  }

  .linea-badge--home {
    color: var(--c-steel);
    background: rgba(74, 127, 165, 0.1);
    border: 1px solid rgba(74, 127, 165, 0.25);
  }

  .linea-badge--ops {
    color: var(--c-cyan);
    background: rgba(0, 200, 255, 0.08);
    border: 1px solid rgba(0, 200, 255, 0.22);
  }

  .linea-title {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 700;
    color: var(--c-navy);
    line-height: 0.93;
    letter-spacing: -0.025em;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .linea-desc {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9375rem;
    color: rgba(27, 42, 74, 0.5);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .linea-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: gap 0.2s ease;
    margin-top: auto;
  }

  .linea-link--home { color: var(--c-steel); }
  .linea-link--ops  { color: var(--c-cyan); }

  .linea-link:hover { gap: 0.8rem; }

  /* ══════════════════════ EL PROCESO ══════════════════════ */
  .proceso-step {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(27, 42, 74, 0.08);
  }

  .proceso-step--care {
    border-top-color: rgba(43, 150, 173, 0.2);
  }

  .proceso-num {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: rgba(27, 42, 74, 0.2);
    margin-bottom: 1.25rem;
  }

  .proceso-num--care {
    color: rgba(43, 150, 173, 0.7);
  }

  .proceso-title {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--c-navy);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .proceso-desc {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9rem;
    color: rgba(27, 42, 74, 0.45);
    line-height: 1.65;
  }

  /* ═════════════════════ CASO PILOTO ═════════════════════ */
  .caso-banner {
    position: relative;
    background: var(--c-charcoal);
    border-radius: 16px;
    padding: 5rem 4.5rem;
    overflow: hidden;
    border: 1px solid rgba(43, 150, 173, 0.12);
  }

  @media (max-width: 768px) {
    .caso-banner {
      padding: 3rem 2rem;
    }
  }

  .caso-content {
    position: relative;
    z-index: 2;
  }

  .caso-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(27, 42, 74, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(27, 42, 74, 0.03) 1px, transparent 1px);
    background-size: 44px 44px;
    pointer-events: none;
  }

  .caso-circles {
    position: absolute;
    right: -80px;
    top: 50%;
    transform: translateY(-50%);
    width: 440px;
    height: 440px;
    pointer-events: none;
  }

  .caso-circles::before,
  .caso-circles::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(43, 150, 173, 0.08);
  }

  .caso-circles::before {
    inset: 0;
  }

  .caso-circles::after {
    inset: 70px;
    border-color: rgba(43, 150, 173, 0.12);
    background: rgba(43, 150, 173, 0.02);
  }

  @media (max-width: 1024px) {
    .caso-circles {
      display: none;
    }
  }

  /* ══════════════════════ RIRO CARE ══════════════════════ */
  .care-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  @media (max-width: 768px) {
    .care-header {
      flex-direction: column;
    }
    .care-badge-wrap {
      display: none;
    }
  }

  .care-badge-wrap {
    flex-shrink: 0;
  }

  .care-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 1px solid rgba(43, 150, 173, 0.25);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: rgba(43, 150, 173, 0.6);
    letter-spacing: 0.05em;
  }

  .care-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media (max-width: 640px) {
    .care-grid {
      grid-template-columns: 1fr;
    }
  }

  .care-card {
    padding: 2rem;
    background: #FFFFFF;
    border-radius: 10px;
    border: 1px solid rgba(27, 42, 74, 0.07);
    transition: border-color 0.25s;
  }

  .care-card:hover {
    border-color: rgba(43, 150, 173, 0.2);
  }

  .care-card--highlight {
    border-color: rgba(43, 150, 173, 0.15);
  }

  .care-icon {
    font-size: 1.1rem;
    color: rgba(27, 42, 74, 0.2);
    margin-bottom: 1.25rem;
  }

  .care-icon--cyan {
    color: var(--c-cyan);
  }

  .care-title {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--c-navy);
    margin-bottom: 0.625rem;
    line-height: 1.3;
  }

  .care-desc {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.875rem;
    color: rgba(27, 42, 74, 0.5);
    line-height: 1.65;
  }

  .care-cta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .btn-care {
    display: inline-flex;
