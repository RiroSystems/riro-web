---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroCarousel from "../components/HeroCarousel.astro";

const heroSlides = [
  {
    image: "https://images.unsplash.com/photo-1486325212027-8081e485255e?w=1920&q=80&fit=crop",
    tag: "Riro Systems",
    title: "Automatización\ncon criterio.",
    desc: "Diseñamos ecosistemas inteligentes que protegen y optimizan tu espacio. Hardware de tu propiedad, procesamiento local y decisiones basadas en razonamiento coherente.",
    cta: { label: "Elige tu solución", href: "#splitter" },
    duration: 9000,
  },
  {
    image: "https://images.unsplash.com/photo-1597733336794-12d05021d510?w=1920&q=80&fit=crop",
    tag: "Filosofía de diseño",
    title: "Raíz japonesa.\nIngeniería sin compromiso.",
    desc: "理路: razonamiento coherente. Cada algoritmo de Riro hereda esa disciplina — estructurado, trazable, sin atajos.",
    cta: { label: "Quiénes somos", href: "/quienes-somos" },
  },
  {
    image: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920&q=80&fit=crop",
    tag: "Edge computing industrial",
    title: "Edge computing para la industria\nque no puede esperar.",
    desc: "Cómputo en el borde del perímetro industrial: decisiones locales, sin dependencia de conectividad externa o nube.",
    cta: { label: "Ver soluciones OPS", href: "/ops" },
  },
  {
    image: "https://images.unsplash.com/photo-1635070041078-e363dbe005cb?w=1920&q=80&fit=crop",
    tag: "Inteligencia artificial",
    title: "Inteligencia artificial instalada.\nNo rentada.",
    desc: "El modelo corre en tu infraestructura. Sin costo por inferencia, sin datos que salgan del perímetro, sin lock-in.",
    cta: { label: "Conocer Riro OPS", href: "/ops" },
  },
];
---

<BaseLayout title="Riro Systems | Automatización con criterio">

  <div id="inicio">
    <HeroCarousel slides={heroSlides} />
  </div>

  <main>

    <!-- ══════════════════════ EL DIVISOR ══════════════════════ -->
    <div class="splitter-label" aria-hidden="true">¿Cuál es tu entorno?</div>
    <section class="splitter" id="splitter">
      <a
        href="/home"
        id="portal-home"
        class="portal portal--home"
        data-funnel="home"
        aria-label="Ir a Riro Home"
      >
        <div class="portal-photo" style="background-image: url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1200&q=80&fit=crop')"></div>
        <div class="portal-overlay portal-overlay--home"></div>
        <div class="portal-content">
          <span class="portal-badge portal-badge--home">HOME</span>
          <h2 class="portal-title">RIRO<br />HOME</h2>
          <p class="portal-desc">Para tu residencia. Tu hogar inteligente, sin dependencias.</p>
          <span class="portal-cta">Conocer solución →</span>
        </div>
        <div class="portal-border portal-border--home"></div>
      </a>

      <a
        href="/ops"
        id="portal-ops"
        class="portal portal--ops"
        data-funnel="ops"
        aria-label="Ir a Riro OPS"
      >
        <div class="portal-photo" style="background-image: url('https://images.unsplash.com/photo-1581092921461-eab62e97a780?w=1200&q=80&fit=crop')"></div>
        <div class="portal-overlay portal-overlay--ops"></div>
        <div class="portal-content">
          <span class="portal-badge portal-badge--ops">OPS</span>
          <h2 class="portal-title">RIRO<br />OPS</h2>
          <p class="portal-desc">Para tu empresa o industria. Inteligencia operativa y seguridad escalable.</p>
          <span class="portal-cta">Conocer solución →</span>
        </div>
        <div class="portal-border portal-border--ops"></div>
      </a>
    </section>

  </main>
</BaseLayout>

<style>
  /* ══════════════════════ SPLITTER ══════════════════════ */
  .splitter-label {
    background: #FFFFFF;
    text-align: center;
    padding: 3rem 1.5rem 2rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #1B2A4A;
  }

  .splitter {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 80vh;
  }

  @media (max-width: 768px) {
    .splitter {
      grid-template-columns: 1fr;
      min-height: auto;
    }
  }

  /* ── Portal base ──────────────────────────────────────── */
  .portal {
    position: relative;
    display: flex;
    align-items: flex-end;
    text-decoration: none;
    overflow: hidden;
    min-height: 560px;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .portal {
      min-height: 420px;
    }
  }

  /* Foto de fondo */
  .portal-photo {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .portal:hover .portal-photo {
    transform: scale(1.04);
  }

  /* Overlay de color */
  .portal-overlay {
    position: absolute;
    inset: 0;
    transition: opacity 0.4s ease;
  }

  .portal-overlay--home {
    background: linear-gradient(
      160deg,
      rgba(74, 127, 165, 0.72) 0%,
      rgba(27, 42, 74, 0.88) 100%
    );
  }

  .portal-overlay--ops {
    background: linear-gradient(
      160deg,
      rgba(43, 150, 173, 0.72) 0%,
      rgba(27, 42, 74, 0.90) 100%
    );
  }

  .portal:hover .portal-overlay--home {
    opacity: 0.85;
  }

  .portal:hover .portal-overlay--ops {
    opacity: 0.85;
  }

  /* Borde lateral activo al hover */
  .portal-border {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .portal--home .portal-border { left: 0; background: #4A7FA5; }
  .portal--ops  .portal-border { right: 0; background: #2B96AD; }

  .portal:hover .portal-border {
    transform: scaleY(1);
  }

  /* Contenido */
  .portal-content {
    position: relative;
    z-index: 2;
    padding: 3rem 3rem 3.5rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  @media (max-width: 1024px) {
    .portal-content {
      padding: 2rem 2rem 2.5rem;
    }
  }

  .portal-badge {
    display: inline-flex;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    padding: 3px 8px;
    border-radius: 3px;
    margin-bottom: 1.5rem;
    width: fit-content;
  }

  .portal-badge--home {
    color: #a8d4f0;
    background: rgba(74, 127, 165, 0.25);
    border: 1px solid rgba(168, 212, 240, 0.35);
  }

  .portal-badge--ops {
    color: #7de8f8;
    background: rgba(43, 150, 173, 0.25);
    border: 1px solid rgba(125, 232, 248, 0.35);
  }

  .portal-title {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 800;
    color: #FFFFFF;
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 0 0 1.5rem;
  }

  .portal-desc {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.6;
    max-width: 320px;
    margin: 0 0 2rem;
  }

  .portal-cta {
    display: inline-flex;
    align-items: center;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: #FFFFFF;
    letter-spacing: 0.02em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    padding-bottom: 2px;
    transition: border-color 0.2s, letter-spacing 0.2s;
    width: fit-content;
  }

  .portal:hover .portal-cta {
    border-color: rgba(255, 255, 255, 0.8);
    letter-spacing: 0.04em;
  }
</style>

<script>
  /* Muro de contención: al hacer clic en un portal, guardar el embudo */
  document.getElementById('portal-home')?.addEventListener('click', () => {
    localStorage.setItem('riro-funnel', 'home');
  });
  document.getElementById('portal-ops')?.addEventListener('click', () => {
    localStorage.setItem('riro-funnel', 'ops');
  });

  /* En la página de inicio, limpiar el embudo para mostrar el navbar completo */
  localStorage.removeItem('riro-funnel');
</script>
