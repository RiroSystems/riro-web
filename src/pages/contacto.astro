---
import BaseLayout from "../layouts/BaseLayout.astro";
import Turnstile from "../components/Turnstile.astro";

const EMAIL           = "contacto@rirosystems.com";
---

<BaseLayout
  title="Contacto"
  description="Hablemos de tu proyecto de automatización. Diseñamos ecosistemas con criterio."
>
  <main class="overflow-x-hidden">

    <!-- ═══════════════════════ ENCABEZADO ═══════════════════════ -->
    <section class="relative pt-36 pb-20 px-6 bg-white overflow-hidden">

      <div class="contacto-header-bg" aria-hidden="true"></div>

      <div class="relative z-10 max-w-6xl mx-auto">

        <div class="flex items-center gap-3 mb-10">
          <span class="w-8 h-px bg-[#2B96AD]"></span>
          <span class="text-[#2B96AD] text-xs font-medium tracking-[0.22em] uppercase">
            Contacto
          </span>
        </div>

        <h1 class="text-[clamp(2.5rem,6vw,5rem)] font-bold leading-[0.95] tracking-tight text-[#1B2A4A] mb-6">
          Hablemos de<br /><span class="contacto-title-accent">tu proyecto.</span>
        </h1>

        <p class="text-[#64748b] text-lg md:text-xl max-w-xl leading-relaxed">
          Diseñamos ecosistemas con criterio. Cuéntanos qué necesitas automatizar.
        </p>

      </div>
    </section>


    <!-- ═══════════════════════ GRID PRINCIPAL ════════════════════ -->
    <section class="py-24 px-6 bg-white">
      <div class="max-w-6xl mx-auto">

        <div class="contacto-grid">

          <!-- ══ COLUMNA IZQUIERDA — Información ══ -->
          <div class="contacto-info">

            <h2 class="text-sm font-medium tracking-[0.18em] text-[#94a3b8] uppercase mb-8">
              Contacto directo
            </h2>

            <!-- Email -->
            <a href="#" class="canal-item canal-item--email email-obf" data-u="contacto" data-d="rirosystems.com">
              <div class="canal-icon canal-icon--email">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div class="canal-body">
                <span class="canal-label">Email</span>
                <span class="canal-value">contacto<span class="eat"></span>rirosystems.com</span>
              </div>
              <span class="canal-arrow">→</span>
            </a>

            <!-- Divider -->
            <div class="contacto-divider"></div>

            <!-- Líneas -->
            <h2 class="text-sm font-medium tracking-[0.18em] text-[#94a3b8] uppercase mb-6">
              Qué atendemos
            </h2>

            <div class="lineas-tags">
              <span class="linea-tag linea-tag--home">RIRO HOME</span>
              <span class="linea-tag linea-tag--ops">RIRO OPS</span>
              <span class="linea-tag">Automatización residencial</span>
              <span class="linea-tag">Monitoreo industrial</span>
              <span class="linea-tag">Integración IoT</span>
              <span class="linea-tag">Consultoría</span>
            </div>

          </div>


          <!-- ══ COLUMNA DERECHA — Formulario ══ -->
          <div class="contacto-form-wrapper">

            <form
              name="contacto"
              method="POST"
              action="/api/contacto"
              class="contacto-form"
            >
              <input type="hidden" name="funnel" value="General" />
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />

              <div class="form-group">
                <label for="nombre" class="form-label">Nombre *</label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  placeholder="Tu nombre completo"
                  required
                  class="form-input"
                />
              </div>

              <div class="form-group">
                <label for="empresa" class="form-label">Empresa / Propiedad</label>
                <input
                  type="text"
                  id="empresa"
                  name="empresa"
                  placeholder="Nombre de tu empresa o propiedad"
                  class="form-input"
                />
              </div>

              <div class="form-group">
                <label for="email" class="form-label">Email *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="tu@email.com"
                  required
                  class="form-input"
                />
              </div>

              <div class="form-group">
                <label for="detalles" class="form-label">Detalles del proyecto</label>
                <textarea
                  id="detalles"
                  name="detalles"
                  rows="5"
                  placeholder="Cuéntanos qué quieres automatizar, el tipo de espacio (casa, local, planta), y cualquier requerimiento específico..."
                  class="form-input form-textarea"
                ></textarea>
              </div>

              <Turnstile />

              <button type="submit" class="form-submit">
                Enviar mensaje
                <span class="form-submit-arrow">→</span>
              </button>

              <p class="form-note">
                Respondemos en menos de 24 hs hábiles.
                Tu información es confidencial y no es compartida con terceros.
              </p>

            </form>

          </div>

        </div>
      </div>
    </section>


    <!-- ═══════════════════════ CIERRE MINIMALISTA ════════════════ -->
    <section class="py-20 px-6 bg-[#F4F7FA] border-t border-[#1B2A4A]/5">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-8">

        <p class="text-[#64748b] text-sm leading-relaxed max-w-lg">
          Cada proyecto empieza con una conversación honesta sobre qué necesitas y qué no.
          Sin propuestas infladas ni tecnología de adorno.
        </p>

        <div class="flex items-center gap-2 flex-shrink-0">
          <span class="text-[#1B2A4A] font-bold tracking-tight">RIRO</span>
          <span class="text-[#2B96AD] font-bold">·</span>
          <span class="text-[#94a3b8] font-medium">SYSTEMS</span>
        </div>

      </div>
    </section>

  </main>
</BaseLayout>

<style>
  :root {
    --c-navy:  #1B2A4A;
    --c-bg:    #F4F7FA;
    --c-cyan:  #2B96AD;
    --c-steel: #4A7FA5;
  }

  /* ══ HEADER ══════════════════════════════════════════════════ */
  .contacto-header-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(43,150,173,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(43,150,173,0.03) 1px, transparent 1px);
    background-size: 72px 72px;
    pointer-events: none;
  }

  .contacto-title-accent {
    color: #2B96AD;
  }

  /* ══ GRID PRINCIPAL ══════════════════════════════════════════ */
  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 6rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .contacto-grid { grid-template-columns: 1fr; gap: 3rem; }
  }

  /* ══ CANALES DE CONTACTO ═════════════════════════════════════ */
  .canal-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    border-radius: 10px;
    border: 1px solid rgba(27,42,74,0.08);
    background: #fff;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
    margin-bottom: 0.75rem;
  }
  .canal-item:hover { transform: translateX(4px); }
  .canal-item--email:hover {
    border-color: rgba(43,150,173,0.25);
    background: rgba(43,150,173,0.04);
  }

  .canal-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    flex-shrink: 0;
    color: #2B96AD;
    background: rgba(43,150,173,0.08);
  }
  .canal-icon--email {
    color: var(--c-cyan);
    background: rgba(43,150,173,0.09);
  }

  .canal-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-grow: 1;
  }
  .canal-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #94a3b8;
    text-transform: uppercase;
  }
  .canal-value {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--c-navy);
    font-family: 'Inter', system-ui, sans-serif;
  }

  .canal-arrow {
    font-size: 1rem;
    color: #cbd5e1;
    transition: color 0.2s, transform 0.2s;
  }
  .canal-item:hover .canal-arrow {
    color: #64748b;
    transform: translateX(2px);
  }

  /* ══ DIVISOR ═════════════════════════════════════════════════ */
  .contacto-divider {
    height: 1px;
    background: rgba(27,42,74,0.07);
    margin: 2rem 0;
  }

  /* ══ TAGS DE LÍNEAS ══════════════════════════════════════════ */
  .lineas-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .linea-tag {
    display: inline-flex;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    border-radius: 4px;
    color: #64748b;
    background: rgba(27,42,74,0.04);
    border: 1px solid rgba(27,42,74,0.07);
  }
  .linea-tag--home {
    color: var(--c-steel);
    background: rgba(74,127,165,0.08);
    border-color: rgba(74,127,165,0.2);
  }
  .linea-tag--ops {
    color: var(--c-cyan);
    background: rgba(43,150,173,0.07);
    border-color: rgba(43,150,173,0.18);
  }

  /* ══ FORMULARIO ══════════════════════════════════════════════ */
  .contacto-form-wrapper {
    background: var(--c-bg);
    border-radius: 16px;
    padding: 2.75rem;
    border: 1px solid rgba(27,42,74,0.07);
  }
  @media (max-width: 640px) { .contacto-form-wrapper { padding: 1.75rem; } }

  .contacto-form { display: flex; flex-direction: column; gap: 1.375rem; }

  .form-group { display: flex; flex-direction: column; gap: 0.5rem; }

  .form-label {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #475569;
    letter-spacing: 0.01em;
  }

  .form-input {
    width: 100%;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9375rem;
    color: var(--c-navy);
    background: #fff;
    border: 1px solid rgba(27,42,74,0.12);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
    -webkit-appearance: none;
  }
  .form-input::placeholder { color: #cbd5e1; }
  .form-input:focus {
    border-color: rgba(43,150,173,0.45);
    box-shadow: 0 0 0 3px rgba(43,150,173,0.08);
  }
  .form-input:hover:not(:focus) { border-color: rgba(27,42,74,0.2); }

  .form-textarea { resize: vertical; min-height: 130px; line-height: 1.6; }

  .form-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 500;
    font-size: 0.9375rem;
    color: #fff;
    background: var(--c-cyan);
    border: none;
    border-radius: 8px;
    padding: 0.9rem 2rem;
    cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s, gap 0.2s;
    width: 100%;
    margin-top: 0.25rem;
  }
  .form-submit:hover {
    background: #239bb2;
    box-shadow: 0 0 24px rgba(43,150,173,0.3);
    gap: 0.875rem;
  }

  .form-submit-arrow { font-size: 1rem; transition: transform 0.2s; }
  .form-submit:hover .form-submit-arrow { transform: translateX(3px); }

  .form-note {
    font-size: 0.75rem;
    color: #94a3b8;
    text-align: center;
    line-height: 1.6;
  }
</style>
