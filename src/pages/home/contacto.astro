---
import BaseLayoutHome from "../../layouts/BaseLayoutHome.astro";

const EMAIL = "contacto@rirosystems.com";
const WHATSAPP_LINK = "https://wa.me/549XXXXXXXXXX";
const WHATSAPP_NUMBER = "+54 9 11 XXXX-XXXX";
---

<BaseLayoutHome
  title="Contacto"
  description="Hablemos de tu proyecto. Diseñamos un ecosistema protegido, automatizado y tuyo, sin depender de nadie para que funcione."
  currentPage="contacto"
>
  <main class="overflow-x-hidden">

    <!-- ═══════════════════════ HERO ═══════════════════════ -->
    <section class="relative pt-36 pb-24 px-6 bg-white overflow-hidden">
      <div class="page-grid-bg" aria-hidden="true"></div>
      <div class="relative z-10 max-w-6xl mx-auto">

        <div class="flex items-center gap-3 mb-8">
          <span class="w-8 h-px bg-[#4A7FA5]"></span>
          <span class="text-[#4A7FA5] text-xs font-medium tracking-[0.22em] uppercase">Riro HOME</span>
        </div>

        <h1 class="text-[clamp(2.75rem,6vw,5rem)] font-bold leading-[0.95] tracking-tight text-[#1B2A4A] mb-6">
          Hablemos de<br />
          <span class="h1-outline">tu proyecto.</span>
        </h1>

        <p class="text-[#64748b] text-lg md:text-xl max-w-xl leading-relaxed">
          Diseñamos un ecosistema protegido, automatizado y tuyo —
          sin depender de nadie para que funcione. El primer paso es
          una conversación sin compromiso.
        </p>

      </div>
    </section>


    <!-- ═══════════════════ GRID: CONTACTO + FORM ═══════════════════ -->
    <section class="py-24 px-6 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="contacto-grid">

          <!-- COLUMNA IZQUIERDA -->
          <div class="contacto-info">

            <p class="info-body">
              Contanos qué querés automatizar o mejorar en tu hogar.
              Respondemos en menos de 24 horas hábiles y, si tiene sentido,
              coordinamos una visita técnica sin costo.
            </p>

            <!-- WhatsApp — canal preferido -->
            <a href={WHATSAPP_LINK} target="_blank" rel="noopener noreferrer" class="canal-wa">
              <div class="canal-wa-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div class="canal-wa-body">
                <span class="canal-wa-label">Escribinos por WhatsApp</span>
                <span class="canal-wa-num">{WHATSAPP_NUMBER}</span>
              </div>
              <span class="canal-wa-arrow">→</span>
            </a>

            <!-- Email secundario -->
            <a href={`mailto:${EMAIL}`} class="canal-email">
              <div class="canal-email-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <span>{EMAIL}</span>
            </a>

            <div class="info-divider"></div>

            <!-- Promesa central -->
            <div class="promise-box">
              <div class="promise-dot"></div>
              <p class="promise-text">
                Hardware de tu propiedad. Procesamiento local. Sin depender
                de nadie para que funcione.
              </p>
            </div>

          </div>


          <!-- COLUMNA DERECHA — Formulario -->
          <div class="form-wrapper">

            <form
              name="contacto-home"
              method="POST"
              action="/gracias"
              class="contacto-form"
            >

              <div class="form-group">
                <label for="nombre" class="form-label">Nombre *</label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  placeholder="Tu nombre"
                  required
                  class="form-input"
                />
              </div>

              <div class="form-group">
                <label for="email" class="form-label">Email *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="tu@email.com"
                  required
                  class="form-input"
                />
              </div>

              <div class="form-group">
                <label for="telefono" class="form-label">Teléfono / WhatsApp</label>
                <input
                  type="tel"
                  id="telefono"
                  name="telefono"
                  placeholder="+54 9 11 XXXX-XXXX"
                  class="form-input"
                />
              </div>

              <div class="form-group">
                <label for="mensaje" class="form-label">¿Qué querés automatizar?</label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  rows="5"
                  placeholder="Contanos brevemente tu proyecto: tipo de espacio, qué querés resolver, cualquier detalle relevante..."
                  class="form-input form-textarea"
                ></textarea>
              </div>

              <button type="submit" class="form-submit">
                Enviar mensaje
                <span class="form-submit-arrow">→</span>
              </button>

              <p class="form-note">
                Respondemos en menos de 24 hs hábiles. Tu información es confidencial.
              </p>

            </form>

          </div>

        </div>
      </div>
    </section>

  </main>
</BaseLayoutHome>

<style>
  :root {
    --c-navy:  #1B2A4A;
    --c-steel: #4A7FA5;
    --c-bg:    #F4F7FA;
  }

  .page-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(74, 127, 165, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(74, 127, 165, 0.03) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
  }
  .h1-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(27, 42, 74, 0.18);
  }

  /* Grid */
  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 7rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .contacto-grid { grid-template-columns: 1fr; gap: 3rem; }
  }

  /* Columna izquierda */
  .info-body {
    font-size: 1rem;
    color: #64748b;
    line-height: 1.72;
    margin: 0 0 2.5rem;
  }

  /* WhatsApp — bloque prominente */
  .canal-wa {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: #fff;
    border: 1.5px solid rgba(37, 211, 102, 0.25);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    margin-bottom: 0.875rem;
  }
  .canal-wa:hover {
    border-color: rgba(37, 211, 102, 0.55);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.08);
  }
  .canal-wa-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: rgba(37, 211, 102, 0.1);
    color: #25d366;
    flex-shrink: 0;
  }
  .canal-wa-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-grow: 1;
  }
  .canal-wa-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--c-navy);
  }
  .canal-wa-num {
    font-size: 0.8rem;
    color: #64748b;
  }
  .canal-wa-arrow {
    font-size: 1rem;
    color: #cbd5e1;
    transition: color 0.2s, transform 0.2s;
  }
  .canal-wa:hover .canal-wa-arrow {
    color: #25d366;
    transform: translateX(3px);
  }

  /* Email — secundario, línea simple */
  .canal-email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #64748b;
    text-decoration: none;
    transition: color 0.18s;
    padding: 0.25rem 0;
  }
  .canal-email:hover { color: var(--c-steel); }
  .canal-email-icon { color: var(--c-steel); opacity: 0.7; flex-shrink: 0; }

  .info-divider {
    height: 1px;
    background: rgba(27, 42, 74, 0.07);
    margin: 2rem 0;
  }

  /* Promesa */
  .promise-box {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .promise-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--c-steel);
    opacity: 0.6;
    flex-shrink: 0;
    margin-top: 8px;
  }
  .promise-text {
    font-size: 0.875rem;
    color: #94a3b8;
    line-height: 1.65;
    font-style: italic;
    margin: 0;
  }

  /* Formulario */
  .form-wrapper {
    background: var(--c-bg);
    border-radius: 16px;
    padding: 2.75rem;
    border: 1px solid rgba(27, 42, 74, 0.07);
  }
  @media (max-width: 640px) { .form-wrapper { padding: 1.75rem; } }

  .contacto-form { display: flex; flex-direction: column; gap: 1.375rem; }
  .form-group    { display: flex; flex-direction: column; gap: 0.5rem; }

  .form-label {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #475569;
    letter-spacing: 0.01em;
  }

  .form-input {
    width: 100%;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9375rem;
    color: var(--c-navy);
    background: #fff;
    border: 1px solid rgba(27, 42, 74, 0.12);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
    -webkit-appearance: none;
  }
  .form-input::placeholder { color: #cbd5e1; }
  .form-input:focus {
    border-color: rgba(74, 127, 165, 0.5);
    box-shadow: 0 0 0 3px rgba(74, 127, 165, 0.08);
  }
  .form-input:hover:not(:focus) { border-color: rgba(27, 42, 74, 0.2); }

  .form-textarea { resize: vertical; min-height: 120px; line-height: 1.6; }

  .form-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 500;
    font-size: 0.9375rem;
    color: #fff;
    background: #4A7FA5;
    border: none;
    border-radius: 8px;
    padding: 0.9rem 2rem;
    cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s, gap 0.2s;
    width: 100%;
    margin-top: 0.25rem;
  }
  .form-submit:hover {
    background: #5a8fb5;
    box-shadow: 0 0 24px rgba(74, 127, 165, 0.35);
    gap: 0.875rem;
  }
  .form-submit-arrow { font-size: 1rem; transition: transform 0.2s; }
  .form-submit:hover .form-submit-arrow { transform: translateX(3px); }

  .form-note {
    font-size: 0.75rem;
    color: #94a3b8;
    text-align: center;
    line-height: 1.6;
  }
</style>
