---
import BaseLayoutHome from "../../layouts/BaseLayoutHome.astro";

const EMAIL = "rirosystems@loreatec.jp";
---

<BaseLayoutHome
  title="Contacto"
  description="Hablemos de tu proyecto. Diseñamos un ecosistema protegido, automatizado y tuyo, sin depender de nadie para que funcione."
  currentPage="contacto"
>
  <main class="overflow-x-hidden">

    <!-- ═══════════════════════ HERO ═══════════════════════ -->
    <section class="relative pt-36 pb-24 px-6 bg-white overflow-hidden">
      <div class="page-grid-bg" aria-hidden="true"></div>
      <div class="relative z-10 max-w-6xl mx-auto">

        <div class="flex items-center gap-3 mb-8">
          <span class="w-8 h-px bg-[#4A7FA5]"></span>
          <span class="text-[#4A7FA5] text-xs font-medium tracking-[0.22em] uppercase">Riro HOME</span>
        </div>

        <h1 class="text-[clamp(2.75rem,6vw,5rem)] font-bold leading-[0.95] tracking-tight text-[#1B2A4A] mb-6">
          Hablemos de<br />
          <span class="h1-outline">tu proyecto.</span>
        </h1>

        <p class="text-[#64748b] text-lg md:text-xl max-w-xl leading-relaxed">
          Diseñamos un ecosistema protegido, automatizado y tuyo —
          sin depender de nadie para que funcione. El primer paso es
          una conversación sin compromiso.
        </p>

      </div>
    </section>


    <!-- ═══════════════════ GRID: CONTACTO + FORM ═══════════════════ -->
    <section class="py-24 px-6 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="contacto-grid">

          <!-- COLUMNA IZQUIERDA -->
          <div class="contacto-info">

            <p class="info-body">
              Cuéntanos qué quieres automatizar o mejorar en tu hogar.
              Respondemos en menos de 24 horas hábiles y, si tiene sentido,
              coordinamos una visita técnica sin costo.
            </p>

            <!-- Email — canal de contacto -->
            <a href={`mailto:${EMAIL}`} class="canal-mail">
              <div class="canal-mail-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div class="canal-mail-body">
                <span class="canal-mail-label">Escríbenos por email</span>
                <span class="canal-mail-num">{EMAIL}</span>
              </div>
              <span class="canal-mail-arrow">→</span>
            </a>

            <div class="info-divider"></div>

            <!-- Promesa central -->
            <div class="promise-box">
              <div class="promise-dot"></div>
              <p class="promise-text">
                Hardware de tu propiedad. Procesamiento local. Sin depender
                de nadie para que funcione.
              </p>
            </div>

          </div>


          <!-- COLUMNA DERECHA — Formulario -->
          <div class="form-wrapper">

            <form
              name="contacto-home"
              method="POST"
              action="/api/contacto"
              class="contacto-form"
            >
              <input type="hidden" name="funnel" value="HOME" />
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />

              <div class="form-group">
                <label for="nombre" class="form-label">Nombre *</label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  placeholder="Tu nombre"
                  required
                  class="form-input"
                />
              </div>

              <div class="form-group">
                <label for="email" class="form-label">Email *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="tu@email.com"
                  required
                  class="form-input"
                />
              </div>

              <div class="form-group">
                <label for="telefono" class="form-label">Teléfono</label>
                <input
                  type="tel"
                  id="telefono"
                  name="telefono"
                  placeholder="+51 9XX XXX-XXXX"
                  class="form-input"
                />
              </div>

              <div class="form-group">
                <label for="mensaje" class="form-label">¿Qué quieres automatizar?</label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  rows="5"
                  placeholder="Cuéntanos brevemente tu proyecto: tipo de espacio, qué quieres resolver, cualquier detalle relevante..."
                  class="form-input form-textarea"
                ></textarea>
              </div>

              <button type="submit" class="form-submit">
                Enviar mensaje
                <span class="form-submit-arrow">→</span>
              </button>

              <p class="form-note">
                Respondemos en menos de 24 hs hábiles. Tu información es confidencial.
              </p>

            </form>

          </div>

        </div>
      </div>
    </section>

  </main>
</BaseLayoutHome>

<style>
  :root {
    --c-navy:  #1B2A4A;
    --c-steel: #4A7FA5;
    --c-bg:    #F4F7FA;
  }

  .page-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(74, 127, 165, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(74, 127, 165, 0.03) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
  }
  .h1-outline {
    color: #4A7FA5;
  }

  /* Grid */
  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 7rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .contacto-grid { grid-template-columns: 1fr; gap: 3rem; }
  }

  /* Columna izquierda */
  .info-body {
    font-size: 1rem;
    color: #64748b;
    line-height: 1.72;
    margin: 0 0 2.5rem;
  }

  /* Email — bloque prominente */
  .canal-mail {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: #fff;
    border: 1.5px solid rgba(43, 150, 173, 0.25);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    margin-bottom: 0.875rem;
  }
  .canal-mail:hover {
    border-color: rgba(43, 150, 173, 0.55);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(43, 150, 173, 0.08);
  }
  .canal-mail-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: rgba(43, 150, 173, 0.1);
    color: #2B96AD;
    flex-shrink: 0;
  }
  .canal-mail-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-grow: 1;
  }
  .canal-mail-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--c-navy);
  }
  .canal-mail-num {
    font-size: 0.8rem;
    color: #64748b;
  }
  .canal-mail-arrow {
    font-size: 1rem;
    color: #cbd5e1;
    transition: color 0.2s, transform 0.2s;
  }
  .canal-mail:hover .canal-mail-arrow {
    color: #2B96AD;
    transform: translateX(3px);
  }

  /* Email — secundario, línea simple */
  .canal-email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #64748b;
    text-decoration: none;
    transition: color 0.18s;
    padding: 0.25rem 0;
  }
  .canal-email:hover { color: var(--c-steel); }
  .canal-email-icon { color: var(--c-steel); opacity: 0.7; flex-shrink: 0; }

  .info-divider {
    height: 1px;
    background: rgba(27, 42, 74, 0.07);
    margin: 2rem 0;
  }

  /* Promesa */
  .promise-box {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .promise-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--c-steel);
    opacity: 0.6;
    flex-shrink: 0;
    margin-top: 8px;
  }
  .promise-text {
    font-size: 0.875rem;
    color: #94a3b8;
    line-height: 1.65;
    font-style: italic;
    margin: 0;
  }

  /* Formulario */
  .form-wrapper {
    background: var(--c-bg);
    border-radius: 16px;
    padding: 2.75rem;
    border: 1px solid rgba(27, 42, 74, 0.07);
  }
  @media (max-width: 640px) { .form-wrapper { padding: 1.75rem; } }

  .contacto-form { display: flex; flex-direction: column; gap: 1.375rem; }
  .form-group    { display: flex; flex-direction: column; gap: 0.5rem; }

  .form-label {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #475569;
    letter-spacing: 0.01em;
  }

  .form-input {
    width: 100%;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9375rem;
    color: var(--c-navy);
    background: #fff;
    border: 1px solid rgba(27, 42, 74, 0.12);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
    -webkit-appearance: none;
  }
  .form-input::placeholder { color: #cbd5e1; }
  .form-input:focus {
    border-color: rgba(74, 127, 165, 0.5);
    box-shadow: 0 0 0 3px rgba(74, 127, 165, 0.08);
  }
  .form-input:hover:not(:focus) { border-color: rgba(27, 42, 74, 0.2); }

  .form-textarea { resize: vertical; min-height: 120px; line-height: 1.6; }

  .form-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 500;
    font-size: 0.9375rem;
    color: #fff;
    background: #4A7FA5;
    border: none;
    border-radius: 8px;
    padding: 0.9rem 2rem;
    cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s, gap 0.2s;
    width: 100%;
    margin-top: 0.25rem;
  }
  .form-submit:hover {
    background: #5a8fb5;
    box-shadow: 0 0 24px rgba(74, 127, 165, 0.35);
    gap: 0.875rem;
  }
  .form-submit-arrow { font-size: 1rem; transition: transform 0.2s; }
  .form-submit:hover .form-submit-arrow { transform: translateX(3px); }

  .form-note {
    font-size: 0.75rem;
    color: #94a3b8;
    text-align: center;
    line-height: 1.6;
  }
</style>
