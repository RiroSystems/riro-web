---
import BaseLayoutHome from "../../layouts/BaseLayoutHome.astro";

const EMAIL = "contacto@rirosystems.com";
const WHATSAPP_LINK = "https://wa.me/549XXXXXXXXXX";
const WHATSAPP_NUMBER = "+54 9 11 XXXX-XXXX";
---

<BaseLayoutHome
  title="Contacto"
  description="Hablemos de tu proyecto. Diseñamos un ecosistema protegido, automatizado y tuyo, sin depender de nadie para que funcione."
  currentPage="contacto"
>
  <script>window.location.replace('/home/contacto');</script>
  <main class="overflow-x-hidden">

    <!-- ═══════════════════════ HERO ═══════════════════════ -->
    <section class="relative pt-36 pb-24 px-6 bg-white overflow-hidden">
      <div class="page-grid-bg" aria-hidden="true"></div>
      <div class="relative z-10 max-w-6xl mx-auto">

        <div class="flex items-center gap-3 mb-8">
          <span class="w-8 h-px bg-[#4A7FA5]"></span>
          <span class="text-[#4A7FA5] text-xs font-medium tracking-[0.22em] uppercase">Primer paso</span>
        </div>

        <h1 class="text-[clamp(2.5rem,5.5vw,4.5rem)] font-bold leading-[0.95] tracking-tight text-[#1B2A4A] mb-6">
          Diseñamos tu ecosistema.<br />
          <span class="h1-outline">Sin depender de nadie para que funcione.</span>
        </h1>

        <p class="text-[#64748b] text-lg md:text-xl max-w-2xl leading-relaxed">
          El relevamiento es una visita técnica, no una visita de ventas. Venimos
          a entender tu espacio, no a cerrar un contrato.
        </p>

      </div>
    </section>


    <!-- ═══════════════════ GRID PRINCIPAL ═══════════════════ -->
    <section class="py-24 px-6 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="relevamiento-grid">

          <!-- COLUMNA IZQUIERDA — Contexto + Promesa -->
          <div class="rev-info">

            <div class="promise-block">
              <p class="promise-heading">Nuestra promesa</p>
              <p class="promise-text">
                Un ecosistema protegido, automatizado y tuyo.<br />
                Sin depender de nadie para que funcione.
              </p>
            </div>

            <div class="rev-divider"></div>

            <h2 class="rev-section-heading">Qué pasa en el relevamiento</h2>
            <div class="rev-steps">
              <div class="rev-step">
                <span class="rev-step-num">01</span>
                <div>
                  <p class="rev-step-title">Recorremos el espacio juntos</p>
                  <p class="rev-step-desc">
                    Analizamos planta, accesos, infraestructura eléctrica y de red.
                    Escuchamos qué querés automatizar y qué problema real necesitás resolver.
                  </p>
                </div>
              </div>
              <div class="rev-step">
                <span class="rev-step-num">02</span>
                <div>
                  <p class="rev-step-title">Producimos un diagnóstico honesto</p>
                  <p class="rev-step-desc">
                    Sin propuesta inflada. Solo lo que realmente necesitás, en el orden
                    que tiene más sentido para tu presupuesto y tus rutinas.
                  </p>
                </div>
              </div>
              <div class="rev-step">
                <span class="rev-step-num">03</span>
                <div>
                  <p class="rev-step-title">Decidís sin presión</p>
                  <p class="rev-step-desc">
                    El relevamiento es sin costo y sin compromiso de avanzar. Si el
                    diagnóstico no convence, no pasa nada. Si convence, sabés exactamente
                    qué estás comprando antes de firmar.
                  </p>
                </div>
              </div>
            </div>

            <div class="rev-divider"></div>

            <h2 class="rev-section-heading">Contacto directo</h2>
            <a href={WHATSAPP_LINK} target="_blank" rel="noopener noreferrer" class="canal-item canal-item--wa">
              <div class="canal-icon canal-icon--wa">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div class="canal-body">
                <span class="canal-label">WhatsApp</span>
                <span class="canal-value">{WHATSAPP_NUMBER}</span>
              </div>
              <span class="canal-arrow">→</span>
            </a>
            <a href={`mailto:${EMAIL}`} class="canal-item canal-item--email">
              <div class="canal-icon canal-icon--email">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div class="canal-body">
                <span class="canal-label">Email</span>
                <span class="canal-value">{EMAIL}</span>
              </div>
              <span class="canal-arrow">→</span>
            </a>

          </div>


          <!-- COLUMNA DERECHA — Formulario -->
          <div class="rev-form-wrapper">

            <p class="form-intro">
              Completá el formulario. Confirmamos la visita en menos de 24 horas hábiles.
            </p>

            <form
              name="relevamiento-home"
              method="POST"
              action="/gracias"
              class="rev-form"
            >

              <div class="form-group">
                <label for="nombre" class="form-label">Nombre *</label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  placeholder="Tu nombre completo"
                  required
                  class="form-input"
                />
              </div>

              <div class="form-group">
                <label for="telefono" class="form-label">Teléfono / WhatsApp</label>
                <input
                  type="tel"
                  id="telefono"
                  name="telefono"
                  placeholder="+54 9 11 XXXX-XXXX"
                  class="form-input"
                />
              </div>

              <div class="form-group">
                <label for="email" class="form-label">Email *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="tu@email.com"
                  required
                  class="form-input"
                />
              </div>

              <div class="form-group">
                <label for="tipo-espacio" class="form-label">Tipo de espacio</label>
                <select id="tipo-espacio" name="tipo-espacio" class="form-input form-select">
                  <option value="" disabled selected>Seleccioná una opción</option>
                  <option value="casa">Casa — Home Essentials</option>
                  <option value="departamento-lujo">Departamento de lujo</option>
                  <option value="country">Country o barrio cerrado</option>
                  <option value="accesible">Hogar con necesidades de accesibilidad</option>
                  <option value="otro">Otro</option>
                </select>
              </div>

              <div class="form-group">
                <label for="descripcion" class="form-label">¿Qué querés automatizar?</label>
                <textarea
                  id="descripcion"
                  name="descripcion"
                  rows="5"
                  placeholder="Contanos brevemente qué problema querés resolver. Por ejemplo: accesos, vigilancia, climatización, asistencia para movilidad reducida..."
                  class="form-input form-textarea"
                ></textarea>
              </div>

              <button type="submit" class="form-submit">
                Solicitar relevamiento
                <span class="form-submit-arrow">→</span>
              </button>

              <p class="form-note">
                Respondemos en menos de 24 hs hábiles. El relevamiento es sin costo
                y sin compromiso de avanzar. Tu información es confidencial.
              </p>

            </form>

          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayoutHome>

<style>
  :root {
    --c-navy:  #1B2A4A;
    --c-steel: #4A7FA5;
    --c-bg:    #F4F7FA;
  }

  .page-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(74, 127, 165, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(74, 127, 165, 0.03) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
  }
  .h1-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(27, 42, 74, 0.18);
  }

  /* Grid */
  .relevamiento-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 6rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .relevamiento-grid { grid-template-columns: 1fr; gap: 3rem; }
  }

  /* Info izquierda */
  .promise-block {
    padding: 1.5rem;
    background: rgba(74, 127, 165, 0.06);
    border: 1px solid rgba(74, 127, 165, 0.18);
    border-radius: 10px;
    margin-bottom: 2rem;
  }
  .promise-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4A7FA5;
    margin: 0 0 0.625rem;
  }
  .promise-text {
    font-size: 1rem;
    font-weight: 600;
    color: var(--c-navy);
    line-height: 1.5;
    margin: 0;
  }

  .rev-divider {
    height: 1px;
    background: rgba(27, 42, 74, 0.07);
    margin: 2rem 0;
  }

  .rev-section-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: 1.5rem;
  }

  .rev-steps {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .rev-step {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .rev-step-num {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #4A7FA5;
    background: rgba(74, 127, 165, 0.1);
    border: 1px solid rgba(74, 127, 165, 0.22);
    padding: 2px 7px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .rev-step-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--c-navy);
    margin: 0 0 0.25rem;
  }
  .rev-step-desc {
    font-size: 0.8375rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  /* Canales */
  .canal-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.125rem;
    border-radius: 10px;
    border: 1px solid rgba(27, 42, 74, 0.08);
    background: #fff;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
    margin-bottom: 0.625rem;
  }
  .canal-item:hover { transform: translateX(4px); }
  .canal-item--wa:hover  { border-color: rgba(37, 211, 102, 0.3); }
  .canal-item--email:hover { border-color: rgba(74, 127, 165, 0.3); }

  .canal-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    flex-shrink: 0;
  }
  .canal-icon--wa    { color: #25d366; background: rgba(37, 211, 102, 0.08); }
  .canal-icon--email { color: #4A7FA5; background: rgba(74, 127, 165, 0.09); }

  .canal-body { display: flex; flex-direction: column; gap: 1px; flex-grow: 1; }
  .canal-label {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #94a3b8;
    text-transform: uppercase;
  }
  .canal-value {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--c-navy);
  }
  .canal-arrow {
    font-size: 1rem;
    color: #cbd5e1;
    transition: color 0.2s, transform 0.2s;
  }
  .canal-item:hover .canal-arrow { color: #64748b; transform: translateX(2px); }

  /* Formulario */
  .rev-form-wrapper {
    background: var(--c-bg);
    border-radius: 16px;
    padding: 2.75rem;
    border: 1px solid rgba(27, 42, 74, 0.07);
  }
  @media (max-width: 640px) { .rev-form-wrapper { padding: 1.75rem; } }

  .form-intro {
    font-size: 0.9375rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .rev-form { display: flex; flex-direction: column; gap: 1.375rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.5rem; }

  .form-label {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #475569;
    letter-spacing: 0.01em;
  }

  .form-input {
    width: 100%;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9375rem;
    color: var(--c-navy);
    background: #fff;
    border: 1px solid rgba(27, 42, 74, 0.12);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
    -webkit-appearance: none;
  }
  .form-input::placeholder { color: #cbd5e1; }
  .form-input:focus {
    border-color: rgba(74, 127, 165, 0.5);
    box-shadow: 0 0 0 3px rgba(74, 127, 165, 0.08);
  }
  .form-input:hover:not(:focus) { border-color: rgba(27, 42, 74, 0.2); }

  .form-select { cursor: pointer; color: var(--c-navy); }
  .form-select option[value=""][disabled] { color: #cbd5e1; }

  .form-textarea { resize: vertical; min-height: 120px; line-height: 1.6; }

  .form-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 500;
    font-size: 0.9375rem;
    color: #fff;
    background: #4A7FA5;
    border: none;
    border-radius: 8px;
    padding: 0.9rem 2rem;
    cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s, gap 0.2s;
    width: 100%;
    margin-top: 0.25rem;
  }
  .form-submit:hover {
    background: #5a8fb5;
    box-shadow: 0 0 24px rgba(74, 127, 165, 0.35);
    gap: 0.875rem;
  }
  .form-submit-arrow { font-size: 1rem; transition: transform 0.2s; }
  .form-submit:hover .form-submit-arrow { transform: translateX(3px); }

  .form-note {
    font-size: 0.75rem;
    color: #94a3b8;
    text-align: center;
    line-height: 1.6;
  }
</style>
