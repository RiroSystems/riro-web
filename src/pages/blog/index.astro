---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString("es-AR", { year: "numeric", month: "long", day: "numeric" });
}
---

<BaseLayout title="Blog | Riro Systems" description="Artículos sobre automatización inteligente, criterio técnico y ecosistemas residenciales e industriales.">
  <main class="overflow-x-hidden">

    <section class="relative min-h-[40vh] flex items-center bg-white">
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="relative z-10 max-w-6xl mx-auto px-6 pt-36 pb-20">
        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-[#4A7FA5]"></span>
          <span class="text-[#4A7FA5] text-xs font-medium tracking-[0.22em] uppercase">Publicaciones</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-[#1B2A4A] leading-tight">
          Blog.
        </h1>
        <p class="text-[#64748b] text-lg mt-4 max-w-lg leading-relaxed">
          Automatización con criterio — en texto.
        </p>
      </div>
    </section>

    <section class="py-20 px-6 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="posts-grid">
          {posts.map((post) => (
            <article class="post-card">
              <div class="post-meta">
                <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                <div class="post-tags">
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <span class="post-tag">{tag}</span>
                  ))}
                </div>
              </div>
              <h2 class="post-title">
                <a href={`/blog/${post.id}/`} class="post-link">
                  {post.data.title}
                </a>
              </h2>
              <p class="post-desc">{post.data.description}</p>
              <a href={`/blog/${post.id}/`} class="post-cta">
                Leer artículo <span>&#x2192;</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  :root {
    --c-navy:  #1B2A4A;
    --c-bg:    #F4F7FA;
    --c-cyan:  #2B96AD;
    --c-steel: #4A7FA5;
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-color: #fff;
    background-image:
      linear-gradient(rgba(43, 150, 173, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(43, 150, 173, 0.03) 1px, transparent 1px);
    background-size: 72px 72px;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 780px;
  }

  .post-card {
    padding: 2rem 2.5rem;
    background: #fff;
    border-radius: 10px;
    border: 1px solid rgba(27, 42, 74, 0.08);
    transition: border-color 0.25s, transform 0.25s;
  }
  .post-card:hover {
    border-color: rgba(43, 150, 173, 0.2);
    transform: translateX(4px);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .post-date {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    color: #94a3b8;
    letter-spacing: 0.04em;
  }

  .post-tags { display: flex; gap: 0.4rem; }

  .post-tag {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--c-cyan);
    background: rgba(43, 150, 173, 0.07);
    border: 1px solid rgba(43, 150, 173, 0.18);
    padding: 2px 7px;
    border-radius: 3px;
  }

  .post-title {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--c-navy);
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .post-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s;
  }
  .post-link:hover { color: var(--c-cyan); }

  .post-desc {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .post-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8375rem;
    font-weight: 500;
    color: var(--c-cyan);
    text-decoration: none;
    transition: gap 0.18s;
  }
  .post-cta:hover { gap: 0.65rem; }
</style>
