  mm?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{tg?.setAttribute('aria-expanded','false');mm?.setAttribute('aria-hidden','true');mm?.classList.remove('open')}));})();

/* ===== hero swiper ===== */
document.addEventListener('DOMContentLoaded',function(){
  new Swiper('.hero-swiper',{loop:true,speed:900,effect:'fade',fadeEffect:{crossFade:true},
