<script is:inline>
/* ===== navbar scroll + mobile ===== */
(()=>{const nb=document.getElementById('navbar-ops'),tg=document.getElementById('no-toggle'),mm=document.getElementById('no-mobile-menu');
  window.addEventListener('scroll',()=>{nb?.classList.toggle('scrolled',window.scrollY>24)},{passive:true});
