<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Piloto Lucca — Prueba viva | Riro OPS</title>
<meta name="description" content="Convierte las cámaras que ya tienes en datos de operación y seguridad — 100% local, sin nube. Probado en el piloto Lucca: 7 semanas, 200+ incidencias con evidencia.">
<link rel="icon" type="image/png" href="/riro_favicon.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<style is:global>
/* ============================================================
   RIRO OPS — design system (fiel a rirosystems.com/ops)
   navy #1B2A4A · cyan #2B96AD · steel #4A7FA5 · bg #F4F7FA · Inter
   ============================================================ */
:root{
  --navy:#1B2A4A; --charcoal:#253761; --cyan:#2B96AD; --cyan-hover:#239bb2;
  --cyan-bright:#3aabbd; --steel:#4A7FA5; --bg:#F4F7FA; --muted:#64748b;
  --line:rgba(27,42,74,.08); --white:#fff;
  --font:Inter,DM Sans,system-ui,-apple-system,sans-serif;
  --maxw:1200px; --content:72rem;
  /* chart tokens (mapeados a la marca) */
  --seq-400:#2B96AD; --seq-250:#4A7FA5; --s1:#2B96AD; --s2:#4A7FA5;
  --grid:rgba(27,42,74,.09); --axis:#94a3b8; --ink:#1B2A4A; --plane:#fff;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:var(--font);background:var(--white);color:var(--navy);
  line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
h1,h2,h3,h4{margin:0;line-height:1.15;letter-spacing:-.02em;font-weight:700}
p{margin:0}
.wrap{max-width:var(--content);margin:0 auto;padding:0 1.5rem}
section{padding:8rem 1.5rem}
@media(max-width:768px){section{padding:5rem 1.25rem}}
.inner{max-width:var(--content);margin:0 auto}

/* eyebrow (línea + texto cyan tracking) */
.eyebrow{display:flex;align-items:center;gap:.75rem;margin-bottom:1.5rem}
.eyebrow.center{justify-content:center}
.eyebrow .line{display:block;width:2rem;height:1px;background:var(--cyan);flex-shrink:0}
.eyebrow .tag{font-size:.7rem;font-weight:500;letter-spacing:.22em;text-transform:uppercase;color:var(--cyan)}
.h2{font-size:clamp(2rem,4.4vw,3rem);font-weight:700;color:var(--navy);line-height:1.12;margin-bottom:1.5rem}
.h2.on-dark{color:#fff}
.lead{font-size:clamp(1rem,1.4vw,1.125rem);color:var(--muted);line-height:1.7;max-width:42rem}
.lead.on-dark{color:rgba(255,255,255,.55)}

/* botones */
.btn-cyan{display:inline-flex;align-items:center;gap:.5rem;font-family:var(--font);font-weight:500;
  font-size:.9375rem;color:#fff;background:var(--cyan);padding:.9rem 1.75rem;border-radius:7px;
  transition:background .2s,box-shadow .2s,gap .2s;white-space:nowrap;border:none;cursor:pointer}
.btn-cyan:hover{background:var(--cyan-hover);box-shadow:0 0 32px #2b96ad61;gap:.75rem}
.btn-navy{display:inline-flex;align-items:center;gap:.5rem;font-weight:500;font-size:.9375rem;color:#fff;
  background:var(--navy);padding:.9rem 1.75rem;border-radius:7px;transition:background .2s,box-shadow .2s,gap .2s;white-space:nowrap}
.btn-navy:hover{background:var(--charcoal);box-shadow:0 0 32px #1b2a4a59;gap:.75rem}
.btn-arrow{transition:transform .2s}
.btn-cyan:hover .btn-arrow,.btn-navy:hover .btn-arrow{transform:translate(3px)}

/* ============ NAVBAR OPS ============ */
.navbar-ops{position:fixed;inset:0 0 auto;z-index:100;background:#ffffffe0;
  backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
  border-bottom:1px solid var(--line);transition:background .3s,border-color .3s}
.navbar-ops.scrolled{background:#fffffff7;border-bottom-color:#1b2a4a1f}
.no-inner{max-width:var(--maxw);margin:0 auto;padding:0 1.5rem;height:64px;display:flex;align-items:center;gap:1.5rem}
.no-logo{display:flex;align-items:center;gap:.6rem;flex-shrink:0}
.no-logo-img{height:40px;width:auto}
.no-section-badge{font-size:.625rem;font-weight:700;letter-spacing:.12em;color:var(--cyan);
  background:#2b96ad1a;border:1px solid rgba(43,150,173,.3);padding:2px 7px;border-radius:4px;margin-top:1px}
.no-nav{display:flex;align-items:center;gap:.125rem;margin-left:auto}
.no-link{position:relative;font-weight:400;font-size:.875rem;color:#1b2a4a9e;
  padding:.375rem .75rem;border-radius:6px;transition:color .18s;white-space:nowrap}
.no-link:after{content:"";position:absolute;left:.75rem;right:.75rem;bottom:.1rem;height:1.5px;
  background:var(--cyan);transform:scaleX(0);transform-origin:left;transition:transform .22s ease}
.no-link:hover{color:var(--navy)}
.no-link:hover:after{transform:scaleX(1)}
.no-link--active{color:var(--cyan)}
.no-link--active:after{transform:scaleX(1)}
.no-cta{flex-shrink:0;font-weight:500;font-size:.8125rem;color:#fff;background:var(--cyan);
  padding:.45rem 1.1rem;border-radius:6px;transition:background .2s,box-shadow .2s;white-space:nowrap}
.no-cta:hover{background:var(--cyan-hover);box-shadow:0 0 18px #2b96ad59}
.no-hamburger{display:none;flex-direction:column;justify-content:center;gap:5px;background:none;
  border:none;cursor:pointer;padding:8px 4px;margin-left:auto;flex-shrink:0}
.no-hamburger span{display:block;width:22px;height:2px;background:#1b2a4aa6;border-radius:2px;
  transform-origin:center;transition:transform .25s,opacity .2s}
.no-hamburger[aria-expanded=true] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.no-hamburger[aria-expanded=true] span:nth-child(2){opacity:0;transform:scaleX(0)}
.no-hamburger[aria-expanded=true] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.no-mobile{display:none;overflow:hidden;max-height:0;background:#fffffffa;
  border-top:1px solid rgba(27,42,74,.07);transition:max-height .32s cubic-bezier(.4,0,.2,1)}
.no-mobile.open{max-height:400px}
.no-mobile nav{display:flex;flex-direction:column;padding:.75rem 1.5rem 1.5rem}
.no-mobile-link{font-size:1rem;color:#1b2a4aa6;padding:.75rem .25rem;
  border-bottom:1px solid rgba(27,42,74,.06);transition:color .18s}
.no-mobile-link:hover{color:var(--navy)}
.no-mobile-cta{display:block;font-weight:500;font-size:.9375rem;color:#fff;background:var(--cyan);
  text-align:center;padding:.8rem 1rem;border-radius:6px;margin-top:1rem;transition:background .2s}
@media(max-width:900px){.no-nav,.no-cta{display:none}.no-hamburger{display:flex}.no-mobile{display:block}}

/* ============ HERO SWIPER ============ */
.hero-carousel{position:relative;width:100%}
.hero-swiper{width:100%;height:100vh;min-height:600px}
.hero-slide{background-size:cover;background-position:center;background-repeat:no-repeat;display:flex;align-items:center}
.slide-overlay{position:absolute;inset:0;background:linear-gradient(to right,#0a1424e6,#0a142499 55%,#0a142440),linear-gradient(to top,rgba(10,20,36,.5) 0%,transparent 40%)}
.slide-content{position:relative;z-index:2;max-width:var(--maxw);width:100%;margin:0 auto;padding:0 1.5rem;padding-top:64px}
.slide-eyebrow{display:flex;align-items:center;gap:.75rem;margin-bottom:1.75rem}
.slide-eyebrow .line{display:block;width:2rem;height:1px;background:var(--cyan);flex-shrink:0}
.slide-eyebrow .tag{font-size:.7rem;font-weight:500;letter-spacing:.22em;text-transform:uppercase;color:var(--cyan)}
.slide-title{font-size:clamp(2rem,5vw,4.25rem);font-weight:700;color:#fff;line-height:1.12;
  letter-spacing:-.02em;max-width:820px;margin-bottom:1.5rem}
.slide-desc{font-size:clamp(1rem,1.5vw,1.1875rem);color:#ffffffad;max-width:560px;line-height:1.7;margin-bottom:2.5rem}
.slide-cta{display:inline-flex;align-items:center;gap:.5rem;font-weight:500;font-size:.9375rem;color:#fff;
  background:var(--navy);padding:.875rem 1.75rem;border-radius:7px;
  transition:background .2s,box-shadow .2s,gap .2s;white-space:nowrap}
.slide-cta:hover{background:var(--charcoal);box-shadow:0 0 32px #1b2a4a59;gap:.75rem}
.slide-cta .cta-arrow{transition:transform .2s}
.slide-cta:hover .cta-arrow{transform:translate(3px)}
/* Slide con captura real: texto a la derecha para no tapar las detecciones (izquierda de la imagen) */
.hero-slide.flip .slide-overlay{background:linear-gradient(to left,#0a1424e6,#0a142499 55%,#0a142440),linear-gradient(to top,rgba(10,20,36,.5) 0%,transparent 40%)}
.hero-slide.flip .slide-content{display:flex;flex-direction:column;align-items:flex-end;text-align:right}
.hero-slide.flip .slide-eyebrow{flex-direction:row-reverse}
.hero-swiper .swiper-button-prev,.hero-swiper .swiper-button-next{width:48px!important;height:48px!important;
  background:#00000059!important;border-radius:50%!important;backdrop-filter:blur(8px)!important;
  color:#fffc!important;transition:background .2s,color .2s!important}
.hero-swiper .swiper-button-prev:hover,.hero-swiper .swiper-button-next:hover{background:#2b96ad59!important;color:#fff!important}
.hero-swiper .swiper-button-prev:after,.hero-swiper .swiper-button-next:after{font-size:1rem!important;font-weight:700!important}
.hero-swiper .swiper-pagination{bottom:1.75rem!important}
.hero-swiper .swiper-pagination-bullet{width:8px!important;height:8px!important;background:#fff6!important;
  opacity:1!important;transition:background .25s,transform .25s!important}
.hero-swiper .swiper-pagination-bullet-active{background:var(--cyan)!important;transform:scale(1.4)!important}
@media(max-width:768px){.hero-swiper{height:92svh;min-height:520px}
  .hero-swiper .swiper-button-prev,.hero-swiper .swiper-button-next{display:none!important}
  .slide-content{padding-top:80px}}

/* ============ STAT STRIP ============ */
.stat-band{background:var(--bg);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0}
@media(max-width:768px){.stat-grid{grid-template-columns:repeat(2,1fr)}}
.stat{padding:2.25rem 1.5rem;border-left:1px solid var(--line)}
.stat:first-child{border-left:none}
@media(max-width:768px){.stat:nth-child(3){border-left:none}}
.stat .big{font-size:clamp(2rem,3.6vw,2.6rem);font-weight:700;color:var(--navy);letter-spacing:-.03em;line-height:1}
.stat .big small{color:var(--cyan);font-size:.6em;font-weight:700}
.stat .lbl{color:var(--muted);font-size:.85rem;margin-top:.55rem;line-height:1.4}

/* ============ FRICTION GRID ============ */
.friction-grid{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:1rem}
@media(max-width:768px){.friction-grid{grid-template-columns:1fr}}
.friction-col{padding:3rem}
@media(max-width:768px){.friction-col{padding:2rem}}
.friction-col--si{border-left:1px solid var(--line)}
@media(max-width:768px){.friction-col--si{border-left:none;border-top:1px solid var(--line)}}
.fc-head{display:flex;align-items:center;gap:.75rem;margin-bottom:2rem}
.fc-num{font-size:.6875rem;font-weight:600;letter-spacing:.14em;color:#1b2a4a33}
.fc-num--cyan{color:#2b96ad99}
.fc-rule{flex:1;height:1px;background:var(--line);max-width:2.5rem}
.fc-heading{font-size:1.125rem;font-weight:500;margin-bottom:2rem}
.fc-heading--muted{color:#1b2a4a59}
.fc-heading--cyan{color:var(--cyan)}
.fc-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:1.25rem}
.fc-item{display:flex;align-items:flex-start;gap:.875rem;font-size:.9375rem;line-height:1.55}
.fc-item--no{color:#1b2a4a61}
.fc-item--si{color:#1b2a4ad9}
.fc-mark{flex-shrink:0;font-size:.75rem;font-weight:600;margin-top:3px}
.fc-mark--no{color:#1b2a4a3d}
.fc-mark--si{color:var(--cyan)}

/* ============ CAP GRID (navy section) ============ */
.sect-navy{background:var(--navy)}
.cap-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#ffffff12;
  border:1px solid rgba(255,255,255,.08);border-radius:12px;overflow:hidden;margin-top:1rem}
@media(max-width:768px){.cap-grid{grid-template-columns:1fr}}
.cap-card{padding:2.5rem;background:#ffffff08;transition:background .25s}
.cap-card:hover{background:#2b96ad14}
.cap-card--highlight{background:#2b96ad0d}
.cap-num{font-size:.6875rem;font-weight:600;letter-spacing:.14em;color:#ffffff4d;margin-bottom:1.25rem}
.cap-num--cyan{color:#2b96adbf}
.cap-title{font-size:1.0625rem;font-weight:600;color:#fff;margin-bottom:.875rem;line-height:1.3}
.cap-desc{font-size:.875rem;color:#ffffff80;line-height:1.7;margin-bottom:1.5rem}
.cap-tags{display:flex;flex-wrap:wrap;gap:.4rem}
.cap-tag{font-size:.7rem;font-weight:500;color:#ffffff73;background:#ffffff0f;
  border:1px solid rgba(255,255,255,.1);padding:2px 8px;border-radius:4px}
.cap-tag--cyan{color:var(--cyan);background:#2b96ad1a;border-color:#2b96ad40}

/* ============ PILOT BANNER (caso Lucca) ============ */
.sect-bg{background:var(--bg)}
.pilot-banner{position:relative;background:var(--navy);border-radius:16px;padding:5rem 4.5rem;
  overflow:hidden;border:1px solid rgba(43,150,173,.1)}
@media(max-width:768px){.pilot-banner{padding:3rem 2rem}}
.pilot-content{position:relative;z-index:2}
.pilot-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(43,150,173,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(43,150,173,.035) 1px,transparent 1px);background-size:44px 44px;pointer-events:none}
.pilot-circles{position:absolute;right:-80px;top:50%;transform:translateY(-50%);width:440px;height:440px;pointer-events:none}
.pilot-circles:before,.pilot-circles:after{content:"";position:absolute;border-radius:50%;border:1px solid rgba(43,150,173,.08)}
.pilot-circles:before{inset:0}
.pilot-circles:after{inset:70px;border-color:#2b96ad1a;background:#2b96ad04}
@media(max-width:1024px){.pilot-circles{display:none}}
.pilot-quote{font-size:clamp(1.15rem,2vw,1.5rem);font-weight:500;color:#fff;line-height:1.5;max-width:44rem;margin:1.5rem 0}
.pilot-quote b{color:var(--cyan)}
.pilot-facts{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:2rem}
.pilot-fact{font-size:.8rem;font-weight:500;color:#ffffffcc;background:#ffffff0f;
  border:1px solid rgba(255,255,255,.12);padding:.45rem .85rem;border-radius:6px}
.client-chip{display:inline-flex;align-items:center;gap:.7rem;background:#ffffff0f;
  border:1px solid rgba(255,255,255,.14);padding:.4rem .95rem .4rem .4rem;border-radius:999px;margin-bottom:1.75rem}
.client-chip img{width:46px;height:46px;border-radius:50%;background:#fff;flex-shrink:0}
.client-chip .cc-name{font-size:.9rem;font-weight:600;color:#fff;line-height:1.15}
.client-chip .cc-sub{font-size:.72rem;color:#ffffff99;font-weight:500}

/* ============ PROOF / CHARTS ============ */
.proof-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-top:1rem}
@media(max-width:860px){.proof-grid{grid-template-columns:1fr}}
.panel{background:#fff;border:1px solid var(--line);border-radius:12px;padding:1.75rem}
.panel h3{font-size:1.0625rem;font-weight:600;color:var(--navy);margin-bottom:.2rem}
.panel .sub{font-size:.82rem;color:var(--muted);margin-bottom:1.25rem}
.legend{display:flex;gap:1.25rem;font-size:.78rem;color:var(--muted);margin-top:.6rem;flex-wrap:wrap}
.legend span{display:inline-flex;align-items:center;gap:.4rem}
.legend i{width:11px;height:11px;border-radius:3px;display:inline-block}
.tip{position:fixed;pointer-events:none;z-index:120;background:var(--navy);color:#fff;font-size:.76rem;
  font-weight:600;padding:.35rem .55rem;border-radius:8px;opacity:0;transform:translate(-50%,-120%);
  transition:opacity .1s;white-space:nowrap;box-shadow:0 6px 20px -6px rgba(0,0,0,.5)}
.axis-lbl{fill:var(--axis);font-size:10px;font-family:var(--font)}
.grid-line{stroke:var(--grid);stroke-width:1}
.bar{transition:.12s}.bar:hover{filter:brightness(1.08)}
/* proof carousel — tour del producto (capturas verticales grandes) */
.proof-carousel{margin-top:2rem;position:relative}
.proof-swiper{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--bg)}
.proof-slide{display:grid;grid-template-columns:1.5fr 1fr;align-items:stretch;min-height:660px}
@media(max-width:820px){.proof-slide{grid-template-columns:1fr;min-height:0}}
.proof-shot{background:var(--navy);display:flex;align-items:center;justify-content:center;padding:2rem 2.5rem;
  background-image:linear-gradient(rgba(43,150,173,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(43,150,173,.05) 1px,transparent 1px);background-size:38px 38px}
.proof-shot img,.proof-shot video{max-height:620px;width:auto;max-width:100%;border-radius:12px;
  box-shadow:0 28px 70px -20px rgba(0,0,0,.7);border:1px solid rgba(255,255,255,.1)}
.proof-shot{position:relative}
.proof-live-badge{position:absolute;top:1.4rem;right:1.6rem;z-index:2;display:inline-flex;align-items:center;gap:.4rem;
  background:#0a1424cc;backdrop-filter:blur(4px);color:#fff;font-size:.7rem;font-weight:600;letter-spacing:.08em;
  text-transform:uppercase;padding:.35rem .6rem;border-radius:999px;border:1px solid rgba(255,255,255,.14)}
.proof-live-badge i{width:7px;height:7px;border-radius:50%;background:#2ecc71;box-shadow:0 0 0 0 #2ecc7166;animation:pulseDot 1.8s infinite}
@keyframes pulseDot{0%{box-shadow:0 0 0 0 #2ecc7180}70%{box-shadow:0 0 0 7px #2ecc7100}100%{box-shadow:0 0 0 0 #2ecc7100}}
@media(max-width:820px){.proof-shot{padding:1.75rem}.proof-shot img,.proof-shot video{max-height:460px}}
.proof-text{padding:2.5rem 3rem;display:flex;flex-direction:column;justify-content:center;background:#fff}
@media(max-width:820px){.proof-text{padding:2rem}}
.proof-text .tag{font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan);margin-bottom:1rem}
.proof-text h3{font-size:1.35rem;font-weight:700;color:var(--navy);margin-bottom:.75rem;line-height:1.2}
.proof-text p{font-size:.95rem;color:var(--muted);line-height:1.7}
.proof-count{font-size:.8rem;font-weight:600;color:#1b2a4a4d;margin-top:1.5rem}
.proof-count b{color:var(--cyan)}
.proof-nav{display:flex;align-items:center;justify-content:center;gap:1rem;margin-top:1.5rem}
.proof-btn{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:#fff;color:var(--navy);
  cursor:pointer;display:grid;place-items:center;transition:.18s;font-size:1.1rem}
.proof-btn:hover{background:var(--cyan);color:#fff;border-color:var(--cyan);box-shadow:0 0 18px #2b96ad4d}
.proof-pagination{display:flex;align-items:center;gap:.5rem}
.proof-pagination .swiper-pagination-bullet{width:8px;height:8px;background:#1b2a4a2e;opacity:1;border-radius:50%;transition:.25s;cursor:pointer}
.proof-pagination .swiper-pagination-bullet-active{background:var(--cyan);transform:scale(1.35)}

/* ============ DIFF GRID (3 pilares — privacidad) ============ */
.diff-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:1rem}
@media(max-width:768px){.diff-grid{grid-template-columns:1fr}}
.diff-item{padding:2.5rem;transition:background .2s}
.diff-item:hover{background:#2b96ad0a}
.diff-item--border{border-left:1px solid var(--line)}
@media(max-width:768px){.diff-item--border{border-left:none;border-top:1px solid var(--line)}}
.diff-num{font-size:.6875rem;font-weight:700;letter-spacing:.14em;color:var(--cyan);margin-bottom:1.5rem}
.diff-title{font-size:1.0625rem;font-weight:600;color:var(--navy);margin-bottom:.875rem}
.diff-desc{font-size:.875rem;color:var(--muted);line-height:1.7}

/* ============ NÚCLEO TÉCNICO — fórmula + inferencia ============ */
.formula-wrapper{margin-top:2rem;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#0f1b30}
.formula-header{display:flex;align-items:center;justify-content:space-between;padding:.7rem 1rem;background:#0a1424;border-bottom:1px solid rgba(255,255,255,.08)}
.formula-label{font-size:.75rem;font-weight:600;color:#ffffff80;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.formula-dots{display:flex;gap:.4rem}
.formula-dots span{width:10px;height:10px;border-radius:50%;background:#ffffff26;display:block}
.formula-code{margin:0;padding:1.5rem;overflow-x:auto;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.82rem;line-height:1.7;color:#cbd5e1}
.formula-code code{white-space:pre}
.formula-comment{color:#64748b}
.formula-keyword{color:var(--cyan);font-weight:600}
.formula-fn{color:#7dd3fc}
.formula-num{color:#f0b866}
.inf-icon{font-size:1.6rem;font-weight:700;color:var(--cyan);margin-bottom:1rem;line-height:1}
.inf-icon--accent{color:var(--steel)}

/* ============ ARQUITECTURA — flujo de capas ============ */
.arq-flow{display:flex;align-items:stretch;gap:1rem;margin-top:2rem;flex-wrap:wrap}
.arq-node{flex:1;min-width:220px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:1.75rem}
.arq-badge{display:inline-block;font-size:.62rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--cyan);background:#2b96ad14;border:1px solid #2b96ad33;padding:2px 8px;border-radius:4px;margin-bottom:1rem}
.arq-title{font-size:1.0625rem;font-weight:700;color:var(--navy);margin-bottom:.6rem}
.arq-desc{font-size:.875rem;color:var(--muted);line-height:1.65}
.arq-arrow{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.3rem;flex-shrink:0}
.arq-arrow-label{font-size:.6rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#94a3b8;white-space:nowrap}
.arq-arrow span:last-child{font-size:1.4rem;font-weight:700;color:var(--cyan)}
@media(max-width:768px){.arq-arrow{transform:rotate(90deg);padding:.4rem 0}.arq-node{min-width:100%}}
.arq-specs{margin-top:2rem;border:1px solid var(--line);border-radius:12px;overflow:hidden}
.arq-legal{font-size:clamp(1.4rem,2.6vw,2rem)!important;color:var(--cyan)}

/* ============ SECTORES ============ */
.sectors{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1rem}
@media(max-width:900px){.sectors{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.sectors{grid-template-columns:1fr}}
.sector{background:#fff;border:1px solid var(--line);border-radius:12px;padding:1.5rem;
  display:flex;gap:.9rem;align-items:flex-start;transition:.2s}
.sector:hover{border-color:#2b96ad55;box-shadow:0 12px 30px -22px rgba(27,42,74,.4)}
.sector .e{font-size:1.5rem;line-height:1}
.sector .tag{font-size:.62rem;font-weight:700;color:var(--cyan);text-transform:uppercase;letter-spacing:.1em}
.sector h3{font-size:1rem;font-weight:600;color:var(--navy);margin:.3rem 0 .25rem}
.sector p{font-size:.86rem;color:var(--muted)}

/* ============ CÓMO FUNCIONA + PLANES ============ */
.steps{display:grid;grid-template-columns:repeat(6,1fr);gap:.75rem;margin-top:1rem;counter-reset:step}
@media(max-width:900px){.steps{grid-template-columns:repeat(3,1fr)}}
@media(max-width:560px){.steps{grid-template-columns:repeat(2,1fr)}}
.step{background:#fff;border:1px solid var(--line);border-radius:12px;padding:1.25rem}
.step::before{counter-increment:step;content:counter(step);display:grid;place-items:center;width:28px;height:28px;
  border-radius:7px;background:var(--cyan);color:#fff;font-weight:700;font-size:.85rem;margin-bottom:.7rem}
.step b{font-size:.92rem;color:var(--navy)}
.step p{font-size:.8rem;color:var(--muted);margin-top:.25rem}
.plans{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-top:2rem}
@media(max-width:760px){.plans{grid-template-columns:1fr}}
.plan{background:#fff;border:1px solid var(--line);border-radius:12px;padding:1.75rem}
.plan.feat{border-color:var(--cyan);box-shadow:0 0 0 1px var(--cyan)}
.plan .tier{font-size:.7rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan)}
.plan h3{font-size:1.15rem;font-weight:700;color:var(--navy);margin:.4rem 0}
.plan .note{font-size:.9rem;color:var(--muted)}
.plan ul{list-style:none;padding:0;margin:1rem 0 0;display:grid;gap:.6rem}
.plan li{display:flex;gap:.6rem;font-size:.9rem;color:#1b2a4ad9;line-height:1.4}
.plan li svg{width:17px;height:17px;color:var(--cyan);flex:0 0 auto;margin-top:2px}
.plan .price{font-size:.85rem;color:var(--muted);margin-top:1rem;font-weight:600}
.plan .price b{color:var(--cyan);font-weight:700}

/* ============ CTA FINAL ============ */
.cta-final{text-align:center}
.cta-form{display:flex;gap:.6rem;max-width:520px;margin:2rem auto 0;flex-wrap:wrap}
.cta-form input{flex:1;min-width:200px;padding:.9rem 1.1rem;border-radius:7px;
  border:1px solid var(--line);font-size:1rem;font-family:inherit;color:var(--navy)}
.cta-form input:focus{outline:none;border-color:var(--cyan)}
.cta-note{display:block;margin-top:1rem;color:var(--muted);font-size:.82rem}

/* ============ FOOTER (fiel a Riro) ============ */
.footer{background:var(--navy);border-top:1px solid rgba(43,150,173,.15);margin-top:0}
.footer-inner{max-width:var(--maxw);margin:0 auto;padding:3.5rem 1.5rem 2.5rem;
  display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:3rem}
.footer-col{display:flex;flex-direction:column}
.footer-brand{font-size:1.35rem;font-weight:800;color:#fff;letter-spacing:-.02em;margin-bottom:.35rem}
.footer-brand span{color:var(--cyan)}
.footer-tagline{font-size:.8rem;font-style:italic;color:rgba(255,255,255,.45);margin:0 0 1.75rem}
.biz-lines{display:flex;flex-direction:column;gap:.65rem}
.biz-item{display:flex;align-items:center;gap:.6rem;transition:opacity .18s}
.biz-item:hover{opacity:.85}
.biz-badge{font-size:.6rem;font-weight:600;letter-spacing:.07em;padding:2px 6px;border-radius:3px;flex-shrink:0}
.biz-home{color:var(--steel);background:#4a7fa51f;border:1px solid rgba(74,127,165,.25)}
.biz-ops{color:var(--cyan);background:#2b96ad1a;border:1px solid rgba(43,150,173,.22)}
.biz-label{font-size:.775rem;color:rgba(255,255,255,.45);line-height:1.3}
.col-heading{font-size:.6875rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
  color:#ffffff4d;margin:0 0 1.25rem}
.footer-nav{display:flex;flex-direction:column;gap:.6rem;margin-bottom:1.25rem}
.footer-link{font-size:.8375rem;color:rgba(255,255,255,.45);transition:color .18s;line-height:1.4}
.footer-link:hover{color:#ffffffd9}
.footer-link--cta{color:var(--cyan);opacity:.85}
.footer-link--cta:hover{opacity:1}
.privacy-note{font-size:.725rem;color:#ffffff38;line-height:1.5;margin:0;padding-top:.5rem;
  border-top:1px solid rgba(255,255,255,.05)}
.footer-demo{display:inline-block;align-self:flex-start;font-weight:500;font-size:.8125rem;color:var(--navy);
  background:var(--cyan);padding:.5rem 1.1rem;border-radius:5px;margin-top:1rem;transition:background .2s,box-shadow .2s}
.footer-demo:hover{background:var(--cyan-bright);box-shadow:0 0 16px #2b96ad59}
.footer-bottom{max-width:var(--maxw);margin:0 auto;padding:1.25rem 1.5rem;border-top:1px solid rgba(255,255,255,.05);
  display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.footer-copy,.footer-origin{font-size:.725rem;color:#fff3;margin:0}
.footer-origin{display:flex;align-items:center;gap:.4rem}
.origin-dot{width:5px;height:5px;border-radius:50%;background:var(--cyan);opacity:.5}
@media(max-width:900px){.footer-inner{grid-template-columns:1fr 1fr;gap:2.5rem}.footer-col:first-child{grid-column:1/-1}}
@media(max-width:560px){.footer-inner{grid-template-columns:1fr;gap:2rem;padding:2.5rem 1.25rem 2rem}
  .footer-col:first-child{grid-column:auto}.footer-bottom{flex-direction:column;align-items:flex-start;gap:.4rem}}
</style>
</head>
