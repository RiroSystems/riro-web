});

/* ===== data real del piloto Lucca (exportado de la API en vivo) ===== */
const AFORO=[{h:13,avg:0.2,max:1},{h:14,avg:0.3,max:2},{h:15,avg:6.7,max:11},{h:16,avg:8.8,max:12},
  {h:17,avg:8.3,max:13},{h:18,avg:9.7,max:14},{h:19,avg:6.2,max:9},{h:20,avg:0.4,max:3}];
const SEMANAS=[{w:'Sem 1',n:11},{w:'Sem 2',n:18},{w:'Sem 3',n:23},{w:'Sem 4',n:31},
  {w:'Sem 5',n:56},{w:'Sem 6',n:11},{w:'Sem 7',n:48},{w:'Sem 8',n:2}];
const TIPOS=[{k:'Ausencia en recepción',n:133,c:'var(--s1)'},{k:'Niños sin supervisión',n:67,c:'var(--s2)'}];
const CAMS=[{k:'Cámara 2',m:16.8},{k:'Cámara 4',m:12.5},{k:'Cámara 3',m:3.0},{k:'Cámara 1',m:0.0}];

const tip=document.getElementById('tip');
function showTip(e,html){tip.innerHTML=html;tip.style.opacity=1;tip.style.left=e.clientX+'px';tip.style.top=e.clientY+'px';}
function hideTip(){tip.style.opacity=0;}
const NS='http://www.w3.org/2000/svg';
function el(n,a){const e=document.createElementNS(NS,n);for(const k in a)e.setAttribute(k,a[k]);return e;}

function areaChart(sel,data,{h=170,pad=26}={}){
  const box=document.querySelector(sel);const w=box.clientWidth||400;
  const svg=el('svg',{viewBox:`0 0 ${w} ${h}`,width:'100%',height:h});
  const maxv=Math.max(...data.map(d=>d.max),1);
  const x=i=>pad+ i*(w-pad*1.4-pad)/(data.length-1);
  const y=v=>h-pad-(v/maxv)*(h-pad*2);
  for(let g=0;g<=maxv;g+=Math.ceil(maxv/3)){svg.appendChild(el('line',{class:'grid-line',x1:pad,x2:w-pad*0.4,y1:y(g),y2:y(g)}));
    const t=el('text',{class:'axis-lbl',x:2,y:y(g)+3});t.textContent=g;svg.appendChild(t);}
  const areaPath=(key,fill,op)=>{let d=`M ${x(0)} ${y(0)}`;data.forEach((p,i)=>d+=` L ${x(i)} ${y(p[key])}`);
    d+=` L ${x(data.length-1)} ${y(0)} Z`;svg.appendChild(el('path',{d,fill,'fill-opacity':op}));};
  areaPath('max','var(--seq-250)',.20);
  areaPath('avg','var(--seq-400)',.20);
  let dl='';data.forEach((p,i)=>dl+=(i?' L ':'M ')+x(i)+' '+y(p.avg));
  svg.appendChild(el('path',{d:dl,fill:'none',stroke:'var(--seq-400)','stroke-width':2}));
  data.forEach((p,i)=>{
    const c=el('circle',{cx:x(i),cy:y(p.avg),r:8,fill:'transparent'});
    c.addEventListener('mousemove',e=>showTip(e,`<b>${p.h}:00</b> · prom ${p.avg} · pico ${p.max}`));
    c.addEventListener('mouseleave',hideTip);svg.appendChild(c);
    svg.appendChild(el('circle',{cx:x(i),cy:y(p.avg),r:3,fill:'var(--seq-400)'}));
    const t=el('text',{class:'axis-lbl',x:x(i),y:h-8,'text-anchor':'middle'});t.textContent=p.h;svg.appendChild(t);});
  box.innerHTML='';box.appendChild(svg);
}
function barChart(sel,data,{h=190,pad=26,color='var(--seq-400)',key='n',lbl='w',fmt=v=>v}={}){
  const box=document.querySelector(sel);const w=box.clientWidth||400;
  const svg=el('svg',{viewBox:`0 0 ${w} ${h}`,width:'100%',height:h});
  const maxv=Math.max(...data.map(d=>d[key]),1);
  const bw=(w-pad-8)/data.length;const y=v=>h-pad-(v/maxv)*(h-pad*1.6);
  for(let g=0;g<=maxv;g+=Math.ceil(maxv/3)){svg.appendChild(el('line',{class:'grid-line',x1:pad,x2:w-4,y1:y(g),y2:y(g)}));
    const t=el('text',{class:'axis-lbl',x:2,y:y(g)+3});t.textContent=g;svg.appendChild(t);}
  data.forEach((p,i)=>{
    const bx=pad+i*bw+bw*0.15,bh=Math.max(h-pad-y(p[key]),0),by=y(p[key]);
    const r=el('rect',{class:'bar',x:bx,y:by,width:bw*0.7,height:bh,rx:4,fill:p.c||color});
    r.addEventListener('mousemove',e=>showTip(e,`<b>${p[lbl]}</b> · ${fmt(p[key])}`));
    r.addEventListener('mouseleave',hideTip);svg.appendChild(r);
    const t=el('text',{class:'axis-lbl',x:bx+bw*0.35,y:h-8,'text-anchor':'middle'});t.textContent=p[lbl];svg.appendChild(t);});
  box.innerHTML='';box.appendChild(svg);
}
function hbarChart(sel,data,{key='n',lbl='k',color='var(--seq-400)',unit='',rowh=44}={}){
  const box=document.querySelector(sel);const w=box.clientWidth||400;const h=data.length*rowh+10;
  const svg=el('svg',{viewBox:`0 0 ${w} ${h}`,width:'100%',height:h});
  const maxv=Math.max(...data.map(d=>d[key]),1);const lw=w*0.42;
  data.forEach((p,i)=>{
    const cy=i*rowh+8;
    const t=el('text',{class:'axis-lbl',x:0,y:cy+rowh/2,'dominant-baseline':'middle'});
    t.setAttribute('style','fill:#1b2a4a99;font-size:12px;font-weight:600');t.textContent=p[lbl];svg.appendChild(t);
    const bw=(p[key]/maxv)*(w-lw-40);
    const r=el('rect',{class:'bar',x:lw,y:cy+6,width:Math.max(bw,2),height:rowh-20,rx:4,fill:p.c||color});
    r.addEventListener('mousemove',e=>showTip(e,`<b>${p[lbl]}</b> · ${p[key]}${unit}`));
    r.addEventListener('mouseleave',hideTip);svg.appendChild(r);
    const vt=el('text',{x:lw+Math.max(bw,2)+8,y:cy+rowh/2,'dominant-baseline':'middle'});
    vt.setAttribute('style','fill:#1b2a4a;font-size:12px;font-weight:700');vt.textContent=p[key]+unit;svg.appendChild(vt);});
  box.innerHTML='';box.appendChild(svg);
}
function renderAll(){
  areaChart('#occChart',AFORO,{h:200});
  barChart('#wkChart',SEMANAS,{h:200,lbl:'w',key:'n',fmt:v=>v+' incidencias'});
  hbarChart('#typeChart',TIPOS,{key:'n',lbl:'k'});
  hbarChart('#camChart',CAMS,{key:'m',lbl:'k',color:'var(--seq-250)',unit:' min'});
}
renderAll();
let rt;window.addEventListener('resize',()=>{clearTimeout(rt);rt=setTimeout(renderAll,150);});
</script>
</body>
</html>
