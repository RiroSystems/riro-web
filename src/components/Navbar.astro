---
// Sin props — el navbar es global y estático
---

<header id="navbar" class="navbar">
  <div class="navbar-inner">

    <!-- Logotipo -->
    <a href="/" class="navbar-logo" aria-label="Riro Systems — Inicio">
      <img src="/Riro.svg" alt="Riro Systems" class="navbar-logo-img" />
    </a>

    <!-- Navegación desktop -->
    <nav class="navbar-nav" aria-label="Navegación principal">
      <a href="/#inicio" class="nav-link">Inicio</a>
      <a href="/quienes-somos" class="nav-link">Quiénes somos</a>
      <a href="/blog" class="nav-link">Blog</a>
    </nav>

    <!-- CTA principal -->
    <a href="/contacto" class="btn-demo">Contacto</a>

    <!-- Botón hamburguesa (mobile) -->
    <button
      id="menu-toggle"
      class="hamburger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>

  <!-- Menú mobile desplegable -->
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <nav aria-label="Navegación móvil">
      <a href="/#inicio"   class="mobile-link">Inicio</a>
      <a href="/quienes-somos" class="mobile-link">Quiénes somos</a>
      <a href="/blog" class="mobile-link">Blog</a>
      <a href="/contacto" class="mobile-cta">Contacto</a>
    </nav>
  </div>
</header>

<style>
  /* ── Tokens locales (valores explícitos para evitar conflictos con Footer) */
  .navbar        { --nb-navy:   #1B2A4A; --nb-cyan: #2B96AD; }
  .nav-link      { --nb-muted:  rgba(27, 42, 74, 0.62); }
  .hamburger     { --nb-subtle: rgba(27, 42, 74, 0.05); }

  /* ── Contenedor principal ───────────────────────────────── */
  .navbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(27, 42, 74, 0.08);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .navbar.scrolled {
    background: rgba(255, 255, 255, 0.97);
    border-bottom-color: rgba(27, 42, 74, 0.12);
  }

  .navbar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  /* ── Logo ───────────────────────────────────────────────── */
  .navbar-logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .navbar-logo-img {
    height: 76px;
    width: auto;
    display: block;
  }

  /* ── Nav desktop ────────────────────────────────────────── */
  .navbar-nav {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    margin-left: auto;
  }

  .nav-link {
    position: relative;
    font-family: 'Inter', 'DM Sans', system-ui, sans-serif;
    font-weight: 400;
    font-size: 0.875rem;
    color: rgba(27, 42, 74, 0.62);
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    transition: color 0.18s;
    white-space: nowrap;
    display: flex;
    align-items: center;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.1rem;
    height: 1.5px;
    background: #2B96AD;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }

  .nav-link:hover {
    color: #1B2A4A;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  /* Badges HOME / OPS */
  .badge {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    padding: 2px 7px;
    border-radius: 4px;
    transition: background 0.18s, border-color 0.18s;
  }

  .badge-home {
    color: #4A7FA5;
    background: rgba(74, 127, 165, 0.12);
    border: 1px solid rgba(74, 127, 165, 0.28);
  }

  .nav-link:hover .badge-home {
    background: rgba(74, 127, 165, 0.22);
    border-color: rgba(74, 127, 165, 0.5);
  }

  .badge-ops {
    color: #2B96AD;
    background: rgba(43, 150, 173, 0.08);
    border: 1px solid rgba(43, 150, 173, 0.25);
  }

  .nav-link:hover .badge-ops {
    background: rgba(43, 150, 173, 0.16);
    border-color: rgba(43, 150, 173, 0.45);
  }

  /* ── CTA "Solicitar Demo" ───────────────────────────────── */
  .btn-demo {
    flex-shrink: 0;
    font-family: 'Inter', 'DM Sans', system-ui, sans-serif;
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.015em;
    color: #FFFFFF;
    background: #1B2A4A;
    text-decoration: none;
    padding: 0.45rem 1.1rem;
    border-radius: 6px;
    transition: background 0.2s, box-shadow 0.2s;
    white-space: nowrap;
  }

  .btn-demo:hover {
    background: #253761;
    box-shadow: 0 0 20px rgba(27, 42, 74, 0.2);
  }

  /* ── Hamburguesa ────────────────────────────────────────── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 4px;
    margin-left: auto;
    flex-shrink: 0;
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: rgba(27, 42, 74, 0.65);
    border-radius: 2px;
    transform-origin: center;
    transition: transform 0.25s ease, opacity 0.2s ease, background 0.2s;
  }

  .hamburger:hover span {
    background: #1B2A4A;
  }

  /* Animación X al abrir */
  .hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Menú mobile ────────────────────────────────────────── */
  .mobile-menu {
    display: none; /* visible solo en mobile via media query */
    overflow: hidden;
    max-height: 0;
    background: rgba(255, 255, 255, 0.98);
    border-top: 1px solid rgba(27, 42, 74, 0.08);
    transition: max-height 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-menu.open {
    max-height: 460px;
  }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1.5rem 1.5rem;
  }

  .mobile-link {
    font-family: 'Inter', 'DM Sans', system-ui, sans-serif;
    font-weight: 400;
    font-size: 1rem;
    color: rgba(27, 42, 74, 0.65);
    text-decoration: none;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid rgba(27, 42, 74, 0.06);
    transition: color 0.18s;
  }

  .mobile-link:last-of-type {
    border-bottom: none;
  }

  .mobile-link:hover {
    color: #1B2A4A;
  }

  .mobile-cta {
    display: block;
    font-family: 'Inter', 'DM Sans', system-ui, sans-serif;
    font-weight: 500;
    font-size: 0.9375rem;
    color: #FFFFFF;
    background: #1B2A4A;
    text-decoration: none;
    text-align: center;
    padding: 0.8rem 1rem;
    border-radius: 6px;
    margin-top: 1rem;
    transition: background 0.2s;
  }

  .mobile-cta:hover {
    background: #253761;
  }

  /* ── Breakpoint mobile ──────────────────────────────────── */
  @media (max-width: 768px) {
    .navbar-nav,
    .btn-demo {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    .mobile-menu {
      display: block;
    }
  }
</style>

<script>
  (() => {
    const navbar = document.getElementById('navbar');
    const toggle = document.getElementById('menu-toggle');
    const menu   = document.getElementById('mobile-menu');

    /* Efecto scroll: más opacidad al bajar */
    window.addEventListener('scroll', () => {
      navbar?.classList.toggle('scrolled', window.scrollY > 24);
    }, { passive: true });

    /* Abrir / cerrar menú hamburguesa */
    toggle?.addEventListener('click', () => {
      const opening = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(opening));
      menu?.setAttribute('aria-hidden',    String(!opening));
      menu?.classList.toggle('open', opening);
    });

    /* Cerrar al tocar un enlace en mobile */
    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        menu?.setAttribute('aria-hidden', 'true');
        menu?.classList.remove('open');
      });
    });

    /* Muro de contención: solo ocultar el tab contrario cuando se está
       dentro de una sección de funnel (/home/... o /ops/...), nunca en raíz */
    const path   = window.location.pathname;
    const inHome = path.startsWith('/home');
    const inOps  = path.startsWith('/ops');
    if (inHome) {
      document.querySelectorAll('[data-funnel-link="ops"]').forEach(el => {
        (el as HTMLElement).style.display = 'none';
      });
    } else if (inOps) {
      document.querySelectorAll('[data-funnel-link="home"]').forEach(el => {
        (el as HTMLElement).style.display = 'none';
      });
    }
  })();
</script>
