---
interface Props {
  currentPage?: string; // 'ops' | 'metodologia' | 'privacidad' | 'criterio' | 'contacto'
}
const { currentPage = '' } = Astro.props;
---

<header id="navbar-ops" class="navbar-ops">
  <div class="no-inner">

    <a href="/ops" class="no-logo" aria-label="Riro OPS — Inicio">
      <img src="/Riro.svg" alt="Riro Systems" class="no-logo-img" />
      <span class="no-section-badge">OPS</span>
    </a>

    <nav class="no-nav" aria-label="Navegación Riro OPS">
      <a href="/ops" class={`no-link ${currentPage === 'ops' ? 'no-link--active' : ''}`}>
        Inteligencia Operativa
      </a>
      <a href="/ops/metodologia" class={`no-link ${currentPage === 'metodologia' ? 'no-link--active' : ''}`}>
        Metodología
      </a>
      <a href="/ops/privacidad" class={`no-link ${currentPage === 'privacidad' ? 'no-link--active' : ''}`}>
        Privacidad y Auditoría
      </a>
      <a href="/ops/criterio" class={`no-link ${currentPage === 'criterio' ? 'no-link--active' : ''}`}>
        El Criterio
      </a>
    </nav>

    <a href="/ops/contacto" class={`no-cta ${currentPage === 'contacto' ? 'no-cta--active' : ''}`}>
      Contacto
    </a>

    <button
      id="no-toggle"
      class="no-hamburger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="no-mobile-menu"
    >
      <span></span><span></span><span></span>
    </button>

  </div>

  <div id="no-mobile-menu" class="no-mobile" aria-hidden="true">
    <nav aria-label="Navegación Riro OPS móvil">
      <a href="/ops" class="no-mobile-link">Inteligencia Operativa</a>
      <a href="/ops/metodologia" class="no-mobile-link">Metodología</a>
      <a href="/ops/privacidad" class="no-mobile-link">Privacidad y Auditoría</a>
      <a href="/ops/criterio" class="no-mobile-link">El Criterio RIRO</a>
      <a href="/ops/contacto" class="no-mobile-cta">Contacto</a>
    </nav>
  </div>
</header>

<style>
  .navbar-ops {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(27, 42, 74, 0.08);
    transition: background 0.3s, border-color 0.3s;
  }
  .navbar-ops.scrolled {
    background: rgba(255, 255, 255, 0.97);
    border-bottom-color: rgba(27, 42, 74, 0.12);
  }

  .no-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .no-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .no-logo-img {
    height: 76px;
    width: auto;
    display: block;
  }
  .no-section-badge {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #2B96AD;
    background: rgba(43, 150, 173, 0.1);
    border: 1px solid rgba(43, 150, 173, 0.3);
    padding: 2px 7px;
    border-radius: 4px;
    margin-top: 1px;
  }

  .no-nav {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    margin-left: auto;
  }
  .no-link {
    position: relative;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 400;
    font-size: 0.875rem;
    color: rgba(27, 42, 74, 0.62);
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    transition: color 0.18s;
    white-space: nowrap;
  }
  .no-link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.1rem;
    height: 1.5px;
    background: #2B96AD;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }
  .no-link:hover {
    color: #1B2A4A;
  }
  .no-link:hover::after {
    transform: scaleX(1);
  }
  .no-link--active {
    color: #2B96AD;
  }
  .no-link--active::after {
    transform: scaleX(1);
  }

  .no-cta {
    flex-shrink: 0;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 500;
    font-size: 0.8125rem;
    color: #fff;
    background: #2B96AD;
    text-decoration: none;
    padding: 0.45rem 1.1rem;
    border-radius: 6px;
    transition: background 0.2s, box-shadow 0.2s;
    white-space: nowrap;
  }
  .no-cta:hover,
  .no-cta--active {
    background: #239bb2;
    box-shadow: 0 0 18px rgba(43, 150, 173, 0.35);
  }

  .no-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 4px;
    margin-left: auto;
    flex-shrink: 0;
  }
  .no-hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: rgba(27, 42, 74, 0.65);
    border-radius: 2px;
    transform-origin: center;
    transition: transform 0.25s, opacity 0.2s;
  }
  .no-hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .no-hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .no-hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .no-mobile {
    display: none;
    overflow: hidden;
    max-height: 0;
    background: rgba(255, 255, 255, 0.98);
    border-top: 1px solid rgba(27, 42, 74, 0.07);
    transition: max-height 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .no-mobile.open { max-height: 400px; }
  .no-mobile nav {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1.5rem 1.5rem;
  }
  .no-mobile-link {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1rem;
    color: rgba(27, 42, 74, 0.65);
    text-decoration: none;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid rgba(27, 42, 74, 0.06);
    transition: color 0.18s;
  }
  .no-mobile-link:hover { color: #1B2A4A; }
  .no-mobile-cta {
    display: block;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 500;
    font-size: 0.9375rem;
    color: #fff;
    background: #2B96AD;
    text-decoration: none;
    text-align: center;
    padding: 0.8rem 1rem;
    border-radius: 6px;
    margin-top: 1rem;
    transition: background 0.2s;
  }
  .no-mobile-cta:hover { background: #239bb2; }

  @media (max-width: 900px) {
    .no-nav, .no-cta { display: none; }
    .no-hamburger { display: flex; }
    .no-mobile { display: block; }
  }
</style>

<script>
  (() => {
    const navbar = document.getElementById('navbar-ops');
    const toggle = document.getElementById('no-toggle');
    const menu   = document.getElementById('no-mobile-menu');

    window.addEventListener('scroll', () => {
      navbar?.classList.toggle('scrolled', window.scrollY > 24);
    }, { passive: true });

    toggle?.addEventListener('click', () => {
      const opening = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(opening));
      menu?.setAttribute('aria-hidden', String(!opening));
      menu?.classList.toggle('open', opening);
    });

    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        menu?.setAttribute('aria-hidden', 'true');
        menu?.classList.remove('open');
      });
    });

    localStorage.setItem('riro-funnel', 'ops');
  })();
</script>
