---
// Navbar de la versión en inglés (/en) — independiente del navbar español.
// Navegación por anclas dentro de la landing corporativa única.
---

<header id="navbar-en" class="navbar">
  <div class="navbar-inner">

    <!-- Logotipo -->
    <a href="/en#top" class="navbar-logo" aria-label="Riro Systems — Home">
      <img src="/Riro.svg" alt="Riro Systems" class="navbar-logo-img" />
    </a>

    <!-- Navegación desktop -->
    <nav class="navbar-nav" aria-label="Main navigation">
      <a href="/en#capabilities" class="nav-link">What we do</a>
      <a href="/en#company" class="nav-link">Who we are</a>
    </nav>

    <!-- Selector de idioma + CTA -->
    <div class="navbar-actions">
      <a href="/" class="lang-toggle" hreflang="es" aria-label="Cambiar a español">ES</a>
      <a href="/en#contact" class="btn-demo">Get in touch</a>
    </div>

    <!-- Botón hamburguesa (mobile) -->
    <button
      id="menu-toggle-en"
      class="hamburger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu-en"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>

  <!-- Menú mobile desplegable -->
  <div id="mobile-menu-en" class="mobile-menu" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <a href="/en#capabilities" class="mobile-link">What we do</a>
      <a href="/en#company" class="mobile-link">Who we are</a>
      <a href="/" class="mobile-link">Español</a>
      <a href="/en#contact" class="mobile-cta">Get in touch</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(27, 42, 74, 0.08);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .navbar.scrolled {
    background: rgba(255, 255, 255, 0.97);
    border-bottom-color: rgba(27, 42, 74, 0.12);
  }

  .navbar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .navbar-logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .navbar-logo-img {
    height: 76px;
    width: auto;
    display: block;
  }

  .navbar-nav {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    margin-left: auto;
  }

  .nav-link {
    position: relative;
    font-family: 'Inter', 'DM Sans', system-ui, sans-serif;
    font-weight: 400;
    font-size: 0.875rem;
    color: rgba(27, 42, 74, 0.62);
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    transition: color 0.18s;
    white-space: nowrap;
    display: flex;
    align-items: center;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.1rem;
    height: 1.5px;
    background: #2B96AD;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }

  .nav-link:hover { color: #1B2A4A; }
  .nav-link:hover::after { transform: scaleX(1); }

  /* ── Acciones (idioma + CTA) ─────────────────────────────── */
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  .lang-toggle {
    font-family: 'Inter', 'DM Sans', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: rgba(27, 42, 74, 0.55);
    text-decoration: none;
    padding: 0.3rem 0.55rem;
    border: 1px solid rgba(27, 42, 74, 0.14);
    border-radius: 6px;
    transition: color 0.18s, border-color 0.18s, background 0.18s;
  }

  .lang-toggle:hover {
    color: #1B2A4A;
    border-color: rgba(43, 150, 173, 0.45);
    background: rgba(43, 150, 173, 0.06);
  }

  .btn-demo {
    font-family: 'Inter', 'DM Sans', system-ui, sans-serif;
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.015em;
    color: #FFFFFF;
    background: #1B2A4A;
    text-decoration: none;
    padding: 0.45rem 1.1rem;
    border-radius: 6px;
    transition: background 0.2s, box-shadow 0.2s;
    white-space: nowrap;
  }

  .btn-demo:hover {
    background: #253761;
    box-shadow: 0 0 20px rgba(27, 42, 74, 0.2);
  }

  /* ── Hamburguesa ────────────────────────────────────────── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 4px;
    margin-left: auto;
    flex-shrink: 0;
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: rgba(27, 42, 74, 0.65);
    border-radius: 2px;
    transform-origin: center;
    transition: transform 0.25s ease, opacity 0.2s ease, background 0.2s;
  }

  .hamburger:hover span { background: #1B2A4A; }

  .hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── Menú mobile ────────────────────────────────────────── */
  .mobile-menu {
    display: none;
    overflow: hidden;
    max-height: 0;
    background: rgba(255, 255, 255, 0.98);
    border-top: 1px solid rgba(27, 42, 74, 0.08);
    transition: max-height 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-menu.open { max-height: 460px; }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1.5rem 1.5rem;
  }

  .mobile-link {
    font-family: 'Inter', 'DM Sans', system-ui, sans-serif;
    font-weight: 400;
    font-size: 1rem;
    color: rgba(27, 42, 74, 0.65);
    text-decoration: none;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid rgba(27, 42, 74, 0.06);
    transition: color 0.18s;
  }

  .mobile-link:hover { color: #1B2A4A; }

  .mobile-cta {
    display: block;
    font-family: 'Inter', 'DM Sans', system-ui, sans-serif;
    font-weight: 500;
    font-size: 0.9375rem;
    color: #FFFFFF;
    background: #1B2A4A;
    text-decoration: none;
    text-align: center;
    padding: 0.8rem 1rem;
    border-radius: 6px;
    margin-top: 1rem;
    transition: background 0.2s;
  }

  .mobile-cta:hover { background: #253761; }

  @media (max-width: 768px) {
    .navbar-nav,
    .navbar-actions { display: none; }
    .hamburger { display: flex; }
    .mobile-menu { display: block; }
  }
</style>

<script>
  (() => {
    const navbar = document.getElementById('navbar-en');
    const toggle = document.getElementById('menu-toggle-en');
    const menu   = document.getElementById('mobile-menu-en');

    window.addEventListener('scroll', () => {
      navbar?.classList.toggle('scrolled', window.scrollY > 24);
    }, { passive: true });

    toggle?.addEventListener('click', () => {
      const opening = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(opening));
      menu?.setAttribute('aria-hidden', String(!opening));
      menu?.classList.toggle('open', opening);
    });

    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        menu?.setAttribute('aria-hidden', 'true');
        menu?.classList.remove('open');
      });
    });
  })();
</script>
